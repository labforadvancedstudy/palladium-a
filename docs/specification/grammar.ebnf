# Palladium Grammar
#
# Version 0.3 (2026-08-22).
#
# THIS FILE HAS TWO PARTS, AND THEY ARE NOT INTERCHANGEABLE.
#
#   Part A (everything up to the NORMATIVE BUT UNPARSED banner near the end)
#   is DERIVED FROM THE PARSER. Every production here is accepted by
#   src/parser/mod.rs today. Constructs that parse but are rejected or
#   miscompiled later are marked; see language-spec.md Part II for each one's
#   failure mode.
#
#   Part B (after that banner) is NORMATIVE BUT UNPARSED: syntax that
#   language-spec.md Part I defines as part of Palladium and that the parser
#   does NOT accept. It is listed separately, never merged into Part A, so that
#   this file can never be read as a claim about the parser's capabilities.
#
# The 2025 version of this file made exactly that mistake: it specified
# where-clauses, trait bounds, closures, slices, tuple expressions, `loop`,
# compound assignment, bitwise operators, `as` casts, labelled breaks,
# range-inclusive, float and char literals, and `else if` inline, as though they
# parsed. None of them did. Widening Part A to match the specification would
# reintroduce that lie; the separation is the fix.
#
# Two of that list have since MOVED, by being implemented rather than by being
# re-described: float and char literals are in Part A below (N2-03, N2-04). The
# rest are still in Part B.
#
# Notation:  |  alternation   ()  grouping   []  optional   {}  zero or more

# =============================================================================
# Lexical
# =============================================================================

whitespace     = ' ' | '\t' | '\n' | '\r' ;
line_comment   = "//" { any_char - '\n' } ;

# Block comments NEST (N2-08): an inner "*/" closes the inner "/*", not the
# outer one, and a "/*" that nothing closes is an error rather than a comment
# to end of file.
block_comment  = "/*" { any_char - "/*" - "*/" | block_comment } "*/" ;

identifier     = ( letter | '_' ) { letter | digit | '_' } ;
letter         = 'a'..'z' | 'A'..'Z' ;
digit          = '0'..'9' ;

# NOTE: the sign is part of the integer token. `i-1` therefore lexes as
# `i` followed by `-1`. Always write `i - 1`.
integer        = [ '-' ] digit { digit } ;

string         = '"' { string_char | escape } '"' ;
string_char    = any_unicode - '"' - '\' ;
char           = "'" ( any_unicode - "'" - '\' | char_escape ) "'" ;

# CLOSED, and SPLIT BY LITERAL KIND. A backslash followed by anything else is a
# compile error, not a pass-through: "\q" used to lex as the two characters \
# and q.
#
# `\0` is legal in a CHAR literal and refused in a STRING: a String is a
# NUL-terminated const char*, so a NUL inside one ends it for every operation
# that reads it. See language-spec.md A2.
escape         = '\' ( 'n' | 't' | 'r' | '"' | '\' | "'" ) ;
char_escape    = escape | '\' '0' ;

boolean        = "true" | "false" ;

# The sign is part of the float token too, so `x-1.5` lexes as `x` then `-1.5`.
# One convention with the integer rule above, not two.
float          = [ '-' ] digit { digit } '.' digit { digit } ;

# There are no hex, binary or octal literals, no numeric separators, no raw
# strings, and no string interpolation. `\xNN` and `\u{}` are not escapes.

keyword        = "fn" | "let" | "mut" | "if" | "else" | "while" | "return"
               | "true" | "false" | "for" | "in" | "break" | "continue"
               | "struct" | "enum" | "trait" | "impl" | "match" | "import"
               | "pub" | "as" | "Self" | "self" | "type" | "const"
               | "unsafe" | "async" | "await" | "macro" ;

# `loop`, `mod`, `use`, `where`, `dyn`, `move`, `static`, `ref`, `crate`,
# `super` and `extern` are NOT keywords — they lex as ordinary identifiers.

operator       = '+' | '-' | '*' | '/' | '%' | '=' | "==" | "!=" | '!'
               | '<' | '>' | "<=" | ">=" | "&&" | "||" | '&' ;

# Absent from the lexer: += -= *= /= %=, | ^ ~ << >>, ..= .

punctuation    = '(' | ')' | '{' | '}' | '[' | ']' | ';' | ',' | ':' | '.'
               | ".." | "->" | "::" | '_' | "=>" | '\'' | '?' | '#' | "#!" ;

# Attributes LEX (N2-10) and every one of them is then REFUSED (N2-11): the set
# of attributes the compiler implements is empty, so `#[total]` is a compile
# error naming `total`. Both rules are in Part A because the parser accepts the
# SHAPE; nothing accepts the name.
attribute      = ( '#' | "#!" ) '[' identifier [ '(' { token } ')' ] ']' ;

# =============================================================================
# Program
# =============================================================================

# All imports must precede all items; an import after an item is a syntax error.
program        = { import } { item } ;

import         = "import" path [ "as" identifier ] ';'
               | "import" path "::" '*' ';'
               | "import" path "::" '{' identifier { ',' identifier } [ ',' ] '}' ';' ;

path           = identifier { "::" identifier } ;

item           = function | struct_def | enum_def | trait_def
               | impl_block | type_alias | macro_def ;

# There is no top-level `const`, `static`, `mod` or `use` item.

# =============================================================================
# Items
# =============================================================================

function       = [ "pub" ] [ "async" ] "fn" identifier [ generic_params ]
                 '(' [ params ] ')' [ "->" type ] block ;

params         = param { ',' param } [ ',' ] ;
param          = [ "mut" ] identifier ':' type
               | self_param ;
self_param     = [ '&' ] [ "mut" ] "self" ;

# Effect clauses (`![io]`) do NOT exist in the surface syntax; effects are
# inferred afterwards and gate nothing.

struct_def     = [ "pub" ] "struct" identifier [ generic_params ]
                 '{' [ field { ',' field } [ ',' ] ] '}' ;
field          = [ "pub" ] identifier ':' type ;

enum_def       = "enum" identifier [ generic_params ]
                 '{' [ variant { ',' variant } [ ',' ] ] '}' ;
variant        = identifier [ '(' type { ',' type } ')'
                            | '{' field { ',' field } '}' ] ;

# `pub` on an enum parses and is then discarded.

trait_def      = [ "pub" ] "trait" identifier [ generic_params ]
                 '{' { trait_item } '}' ;
trait_item     = "fn" identifier [ generic_params ] '(' [ params ] ')'
                 [ "->" type ] ( block | ';' ) ;

# A trait method declared with a `self` receiver is a PARSE ERROR: trait methods
# use a parameter loop that does not accept `self`. Traits also emit no code.

impl_block     = "impl" [ generic_params ] [ type "for" ] type '{' { function } '}' ;

# An impl body may contain only functions — no associated consts or types.

type_alias     = [ "pub" ] "type" identifier [ generic_params ] '=' type ';' ;

macro_def      = "macro" identifier '!' '(' [ pattern ] ')' block ;

generic_params = '<' generic_param { ',' generic_param } '>' ;
generic_param  = "'" identifier                 (* lifetime *)
               | identifier                     (* type *)
               | "const" identifier ':' type ;  (* const, fn/struct/enum only *)

# Trait bounds (`<T: Display>`) are a parse error: only bare names are accepted.
# Inside `<...>` an all-uppercase name is reclassified as a CONST argument, so
# `Foo<T>` does not mean what it appears to.

# =============================================================================
# Types
# =============================================================================

type           = primitive | reference | array | tuple | generic | path | "Self" ;

primitive      = "i64" | "int" | "i32" | "u32" | "u64" | "bool" | "String" | "()" ;
reference      = '&' [ "'" identifier ] [ "mut" ] type ;
array          = '[' type ';' ( integer | identifier ) ']' ;
tuple          = '(' [ type { ',' type } [ ',' ] ] ')' ;
generic        = identifier '<' type { ',' type } '>' ;

# No f32/f64, char, str, u8, usize. No function types, slices, `dyn` or `impl`
# trait. Tuples parse but lower to void* and cannot be constructed.
# Option and Result are NOT built in; they are ordinary user enums.

# =============================================================================
# Statements
# =============================================================================

statement      = let_stmt | assign_stmt | if_stmt | while_stmt | for_stmt
               | match_stmt | return_stmt | break_stmt | continue_stmt
               | unsafe_stmt | expr_stmt ;

# The initializer is mandatory, and the binding is a bare identifier —
# `let` patterns do not exist.
let_stmt       = "let" [ "mut" ] identifier [ ':' type ] '=' expression ';' ;

assign_stmt    = place '=' expression ';' ;
place          = identifier | place '[' expression ']' | place '.' identifier
               | '*' identifier ;

# There is NO `else if`: after `else` the parser requires '{'.
if_stmt        = "if" expression block [ "else" block ] ;

while_stmt     = "while" expression block ;

# `for` iterates a range or an array. Iterating an array PARAMETER miscompiles.
for_stmt       = "for" identifier "in" expression block ;

match_stmt     = "match" expression '{' { match_arm } '}' ;
match_arm      = pattern "=>" ( block | expression ) [ ',' ] ;

return_stmt    = "return" [ expression ] ';' ;
break_stmt     = "break" ';' ;
continue_stmt  = "continue" ';' ;
unsafe_stmt    = "unsafe" block ;
expr_stmt      = expression ';' ;

block          = '{' { statement } [ expression ] '}' ;

# A trailing expression in a function body with a declared return type is
# lowered to a return. A trailing expression in a nested block is not.
# There is no bare nested block as a statement, and no `loop`.

# =============================================================================
# Expressions
# =============================================================================
#
# `if`, `match` and blocks are STATEMENTS, not expressions:
# `let x = if c { 1 } else { 2 };` does not parse.

expression     = range ;
range          = logical_or [ ".." logical_or ] ;   (* only valid in a `for` header *)
logical_or     = logical_and { "||" logical_and } ;
logical_and    = equality { "&&" equality } ;
equality       = comparison { ( "==" | "!=" ) comparison } ;
comparison     = addition { ( '<' | '>' | "<=" | ">=" ) addition } ;
addition       = multiplication { ( '+' | '-' ) multiplication } ;
multiplication = unary { ( '*' | '/' | '%' ) postfix } ;
unary          = ( '-' | '!' | '*' | '&' [ "mut" ] ) unary | postfix ;

postfix        = primary { '[' expression ']'
                         | '(' [ arguments ] ')'
                         | '.' identifier
                         | "::" identifier [ '(' [ arguments ] ')'
                                           | '{' field_init_list '}' ]
                         | '?'
                         | ".await" } ;

primary        = integer | string | boolean | "self" | identifier
               | struct_literal | array_literal | '(' expression ')'
               | macro_call ;

struct_literal = path '{' [ field_init { ',' field_init } [ ',' ] ] '}' ;
field_init     = identifier ':' expression ;
field_init_list = field_init { ',' field_init } [ ',' ] ;

array_literal  = '[' [ expression { ',' expression } [ ',' ] ] ']'
               | '[' expression ';' expression ']' ;

macro_call     = identifier '!' '(' { any_token } ')' ;

arguments      = expression { ',' expression } [ ',' ] ;

# Method-call syntax `x.f()` parses but the type checker rejects it:
# "Indirect function calls not yet supported". Call `Type::f(x)` instead.
#
# There are no closures, no tuple expressions, no `.0` indexing, no `as` casts.
# `?` and `.await` appear here because they parse. Nothing lowers them: both are
# rejected after parsing with "is not implemented" (type checker, then codegen).
# See language-spec.md §6.5.
#
# Known precedence bug: multiplication parses its RIGHT operand with `postfix`
# rather than `unary`, so `a * -b` fails to parse. Write `a * (0 - b)`.

# =============================================================================
# Patterns  (exactly three forms exist)
# =============================================================================

pattern        = '_'
               | identifier
               | path "::" identifier [ '(' pattern { ',' pattern } ')'
                                      | '{' identifier ':' pattern
                                            { ',' identifier ':' pattern } '}' ] ;

# No literal patterns, ranges, or-patterns, guards, tuple/slice patterns,
# `ref`/`mut` bindings, `@` bindings, field shorthand, or `..` rest.
# Consequence: `match` cannot dispatch on an integer or a string.

# =============================================================================
# Operator precedence (tightest first)
# =============================================================================
# 1. literals, identifiers, paths, struct and array literals, grouping
# 2. postfix: indexing, call, field, `::`, `?`, `.await`
# 3. unary: - ! * & &mut
# 4. * / %
# 5. + -
# 6. < > <= >=
# 7. == !=
# 8. &&
# 9. ||
# 10. ..     (only meaningful in a `for` header)
#
# Assignment is a STATEMENT, not an operator, so it has no precedence entry.

# =============================================================================
# =============================================================================
# NORMATIVE BUT UNPARSED
# =============================================================================
# =============================================================================
#
# Everything below is part of the language as defined by language-spec.md Part I
# and is NOT accepted by src/parser/mod.rs at commit abeb665. Nothing here is a
# claim about the compiler. Each entry names the normative section it comes from
# and, where the blocker is below the parser, says so.
#
# Do not move a production from here into Part A because it "should" work. Move
# it when `pdc` parses it, and add the conformance row that proves it.

# ---- Attributes (spec N2, N8) ------------------------------------------------
# BLOCKER IS LEXICAL: there is no '#' token. `#[total]` fails with
# "Unexpected character '#' at line 1, column 1", before the parser runs.

attribute       = "#" [ "!" ] "[" attr_name [ "(" attr_args ")" ] "]" ;
attr_name       = identifier ;
attr_args       = attr_arg { "," attr_arg } ;
attr_arg        = identifier "=" expression | expression | identifier ;

# The totality obligations of spec N8 are all attributes:
#   #![total(strict)]   #[total]   #[decreases(expr)]
#   #[total(fuel = N)]  #[partial]

# ---- References and lifetimes (spec N9) --------------------------------------
# `ref` is not a keyword (see the keyword list in Part A); it lexes as an
# ordinary identifier, so none of these parse.

ref_type        = "ref" [ "mut" ] type
                | "ref" "<" "'" identifier ">" [ "mut" ] type ;

# Part A's `reference = '&' [ "'" identifier ] [ "mut" ] type` is the IMPLEMENTED
# spelling. Spec N9 removes both the '&' sigil and the `'a` parameter lists that
# Part A's `generic_param` still accepts.

# ---- Effects and asynchrony (spec N7) ----------------------------------------
# Spec N7 REMOVES syntax rather than adding it: `async` must stop being a
# function modifier and `.await` must stop being a postfix operator. Both appear
# in Part A because the parser accepts them; neither is normative.
#
# What N7 adds, and what does not parse (`with` and `effect` are not keywords):

effect_context  = "with_timeout" "(" expression ")" block
                | "with_retry" "(" expression [ "," expression ] ")" block
                | "with" identifier "{" field_init_list "}" block ;
effect_escape   = "effect" "::" "sync" block ;
async_ret_type  = "async" type ;              (* only in `-> async T` *)
effect_decl     = "effect" identifier "{" field { "," field } "}" ;

# ---- Types (spec N4) ---------------------------------------------------------

# float_literal and char_literal MOVED TO PART A (N2-03, N2-04): the parser
# accepts both. `f32`/`f64` and `char` as TYPE NAMES are a separate matter --
# `f32` and `f64` parse; `char` does not, because a char literal's type is i64
# until N4-04 and N14-04 move together.
slice_type      = "[" type "]" ;
fn_type         = "fn" "(" [ type { "," type } ] ")" [ "->" type ] ;
# Primitives absent from the implemented table: char str u8 usize
# (f32 and f64 are implemented; see N2-03/N4-02.)

# ---- Generics and traits (spec N10) ------------------------------------------
# Part A accepts only bare names inside <...>, and reclassifies an all-uppercase
# name as a const argument.

bounded_param   = identifier ":" bound { "+" bound } ;
bound           = path [ "<" type { "," type } ">" ] ;
where_clause    = "where" bounded_param { "," bounded_param } ;
trait_item_norm = "fn" identifier "(" [ self_param [ "," params ] ] ")"
                  [ "->" type ] ( block | ";" )
                | "type" identifier [ ":" bound ] ";"
                | "const" identifier ":" type [ "=" expression ] ";" ;

# ---- Expressions and statements (spec N5) ------------------------------------
# In Part A, `if`, `match` and blocks are STATEMENTS. Spec N5 makes them
# expressions, which changes `expression`, not merely adds to it.

expression_norm = ... | if_expr | match_expr | block | closure | try_expr ;
if_expr         = "if" expression block { "else" "if" expression block }
                  [ "else" block ] ;
closure         = [ "move" ] "|" [ params_untyped ] "|" ( expression | block ) ;
try_expr        = "try" block ;
loop_stmt       = "loop" block ;
break_value     = "break" [ expression ] ";" ;
compound_assign = place ( "+=" | "-=" | "*=" | "/=" | "%=" ) expression ";" ;
bitwise_op      = "|" | "^" | "~" | "<<" | ">>" ;
cast_expr       = expression "as" type ;
range_incl      = expression "..=" expression ;
tuple_expr      = "(" expression { "," expression } [ "," ] ")" ;
tuple_index     = expression "." integer ;

# Precedence correction (spec N5): `a * -b` must parse. Part A's
# `multiplication = unary { ( '*' | '/' | '%' ) postfix }` parses its RIGHT
# operand with `postfix`, so it does not. The normative rule is:
#   multiplication = unary { ( '*' | '/' | '%' ) unary } ;

# ---- Patterns (spec N6) ------------------------------------------------------
# Part A has exactly three pattern forms. Spec N6 requires all of these, and
# requires exhaustiveness for every scrutinee type, not only enums.

pattern_norm    = literal
                | expression ".." expression
                | expression "..=" expression
                | pattern_norm "|" pattern_norm
                | identifier "@" pattern_norm
                | "(" pattern_norm { "," pattern_norm } ")"
                | "[" pattern_norm { "," pattern_norm } [ ".." ] "]"
                | path "{" identifier [ ":" pattern_norm ] { "," ... } [ ".." ] "}" ;
match_arm_norm  = pattern_norm [ "if" expression ] "=>" ( block | expression ) [ "," ] ;

# ---- Items and modules (spec N3, N11) ----------------------------------------

const_item      = [ "pub" ] "const" identifier ":" type "=" expression ";" ;
static_item     = [ "pub" ] "static" [ "mut" ] identifier ":" type "=" expression ";" ;
module_item     = [ "pub" ] "mod" identifier ( "{" { item } "}" | ";" ) ;
extern_block    = "extern" string "{" { fn_signature ";" } "}" ;
