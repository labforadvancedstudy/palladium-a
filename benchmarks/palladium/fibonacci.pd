// Fibonacci benchmark in Palladium (PBS-1 subset)
// Tests recursive function call overhead and integer arithmetic.
//
// Workload: naive recursive fib(42) = 267914296 (~866M calls).
// Output must stay byte-identical to benchmarks/rust/fibonacci.rs
// and benchmarks/c/fibonacci.c.

fn fibonacci(n: i64) -> i64 {
    if n <= 1 {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn main() {
    let n: i64 = 42;
    print("benchmark: fibonacci");
    print("n:");
    print_int(n);
    let result: i64 = fibonacci(n);
    print("result:");
    print_int(result);
}
