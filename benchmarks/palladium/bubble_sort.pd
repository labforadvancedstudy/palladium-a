// Bubble sort benchmark in Palladium (PBS-1 subset)
// Tests array indexing, comparison branches and swapping.
//
// Workload: 45000 elements in reverse order (worst case) => ~1.0G compare/swap.
// PBS-1 notes:
//   - arrays pass directly as `mut arr: [i64; N]`, never `&mut [i64; N]` (defect D9)
//   - arrays are walked with `while` + index, never `for` over a parameter (defect D4)
// Output must stay byte-identical to benchmarks/rust/bubble_sort.rs
// and benchmarks/c/bubble_sort.c.

fn bubble_sort(mut arr: [i64; 45000], n: i64) {
    let mut i: i64 = 0;
    while i < n - 1 {
        let mut j: i64 = 0;
        while j < n - i - 1 {
            if arr[j] > arr[j + 1] {
                let temp: i64 = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn checksum(mut arr: [i64; 45000], n: i64) -> i64 {
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        sum = sum + arr[i] * (i % 7 + 1);
        i = i + 1;
    }
    return sum;
}

fn main() {
    let n: i64 = 45000;
    print("benchmark: bubble_sort");
    print("n:");
    print_int(n);

    let mut arr: [i64; 45000] = [0; 45000];
    let mut i: i64 = 0;
    while i < n {
        arr[i] = n - i;
        i = i + 1;
    }

    bubble_sort(arr, n);

    print("first:");
    print_int(arr[0]);
    print("last:");
    print_int(arr[44999]);
    print("checksum:");
    print_int(checksum(arr, n));
}
