// ============================================================================
// WT-01 — witness 2: a JSON parser (RFC 8259).
//
// THIS FILE DOES NOT SATISFY WT-01. WT-01 asks for a JSON parser written with
// NO WORKAROUNDS. This one runs, and it is built out of thirteen of them. Every
// one is marked `// WORKAROUND <row>:` at the point of use — fourteen such
// comments below this header, thirteen distinct workarounds, because N5-12 is
// worked around at two separate sites. A fifteenth comment is marked
// `// WORKAROUND DISCHARGED` and is not one of them: it records the constant
// workaround that N3-09/N3-10 removed, so that the count's history stays
// readable at the site it changed. `<row>` is the requirement id that owns
// the missing construct, or the word UNOWNED, which means the construct that
// would remove the workaround is declared by NOTHING in
// docs/contributing/1.0-requirements.tsv. Four of the fourteen are UNOWNED, and
// those are the ones a roadmap reading of N5/N6 cannot see.
//
// The count has moved five times, and every move is a fact about the compiler
// rather than a rewording here. The fifth is the only one where the missing
// construct ARRIVED rather than a claim being re-measured: M2 item 9 landed
// top-level `const` and `static`, the two zero-arg constant functions became
// `const` items, and the count fell fourteen -> thirteen. `cfa7e7f` gave recursive types a layout and a
// diagnostic, closing one UNOWNED workaround. Two more closed when the claims
// under them were re-measured against the compiler that is actually here:
// char literals lex (N2-04, `satisfied`), so twenty-nine of the thirty-one
// zero-arg byte-code functions are gone — `ch_backspace` and `ch_formfeed`
// stay because `'\b'` and `'\f'` are a compile error, and that is the closed
// escape set behaving correctly, not a workaround; and `"\\t"` lexes to
// backslash + `t` (N2-09, `satisfied`), so the hand-assembled backslash is
// gone. One move went the other way. The number workaround was tagged N4-02,
// which is `satisfied` — `f64` exists — so the tag was wrong. What is actually
// missing is any way to move a float ACROSS the text boundary, in EITHER
// direction: no `string_to_float` and no `parse_float`, so a lexeme cannot
// become a value, and no `float_to_string` and no `print_float`, so a value
// cannot be printed. No row owns either direction, so re-tagging it UNOWNED
// raised that count from three to four.
//
// The shape this file would have if nothing were missing is written out in
// tests/witness/json_parser.no-workarounds.md, beside a per-workaround diff, so
// that when the remaining rows land the claim "the workarounds are gone" can be
// CHECKED rather than re-derived. Items 3, 4 and 9 have landed; WT-01 stays
// `owed` because thirteen workarounds remain, four of them UNOWNED.
//
// What it does: parses one JSON document into a flat arena, re-serialises it
// canonically, answers structural queries against it, and refuses fifteen
// malformed documents at a named byte offset. Fifteen is checkable rather than
// claimed: `grep -cE '^[[:space:]]*show_err\(j,' tests/witness/json_parser.pd`
// is 15 — the call sites in `main`, anchored so that this sentence does not
// count itself — and the pinned transcript carries fifteen lines after its
// `-- refused --` marker. The transcript is tests/witness/json_parser.expected;
// every line of it is checkable by reading the input strings in `main` below.
// ============================================================================

// ---------------------------------------------------------------------------
// Named constants.
//
// WORKAROUND DISCHARGED (N3-09, N3-10): these were `fn cap_nodes() -> i64` and
// `fn max_depth() -> i64`, zero-arg functions standing in for constants because
// `const LIMIT: i64 = 10;` was "Expected function, struct, enum, trait, type,
// impl, or macro declaration". Top-level `const` items exist now, so each use is
// a name again rather than a call. This is the first workaround in this file
// removed by the construct ARRIVING rather than by re-measuring a claim.
// ---------------------------------------------------------------------------

const CAP_NODES: i64 = 192;
const MAX_DEPTH: i64 = 24;

// Node kinds.
//
// WORKAROUND UNOWNED: these are an `enum` in any language that has one, and
// Palladium HAS enums — but an array of them cannot be built. Both
// `[K::A; 4]` and `[K::A, K::A, K::A, K::A]` are refused with
// "Type mismatch: expected [K; 4], found [K; 4]", a diagnostic that names the
// same type on both sides. N4-09 is `satisfied` and states it is witnessed for
// `[i64; 5]`, `[i64; 3]`, `[String; 3]` only, so it does not cover this; no
// other row does either. The arena therefore stores kinds as i64.
fn k_null() -> i64 { return 0; }
fn k_false() -> i64 { return 1; }
fn k_true() -> i64 { return 2; }
fn k_number() -> i64 { return 3; }
fn k_string() -> i64 { return 4; }
fn k_array() -> i64 { return 5; }
fn k_object() -> i64 { return 6; }

// The two character codes with no literal form.
//
// The escape set is closed: `\n \t \r \" \\ \'` in a string literal, those
// plus `\0` in a char literal (N2-09, satisfied). `'\b'` and `'\f'` are an
// "unknown escape sequence" compile error. JSON names both escapes, so these
// two bytes -- and only these two -- are written here as decimals. Every other
// character this parser dispatches on is written as the char literal it is.
fn ch_backspace() -> char { return 8 as char; }
fn ch_formfeed() -> char { return 12 as char; }

// ---------------------------------------------------------------------------
// The document.
//
// WORKAROUND N14-09 + N4-12 + N4-15: the natural representation is
//
//     enum Json { Null, Bool(bool), Number(f64), Str(String),
//                 Array(Vec<Json>), Object(Vec<(String, Json)>) }
//
// and it is still not reachable — but as of cfa7e7f the recursion is no longer
// what stops it.
//   * The recursive variants WORK. `enum V { Leaf(i64), Pair(V, V) }` compiles,
//     links and runs: a self-recursive `depth` over the bound payloads returns 3
//     for `Pair(Leaf, Pair(Leaf, Leaf))`. The one indirection this compiler
//     introduces is an `enum` payload slot whose type reaches its own enum, and
//     a cycle with no such slot is refused BY NAME rather than handed to gcc:
//     `enum J { Num(i64), Arr([J; 4]) }` gives "recursive type `J` has no layout:
//     it stores itself by value (J -> J), and nothing on that cycle can stop ...
//     Break the cycle by routing it through an `enum` variant that can stop".
//   * `Vec<T>` is N14-09, owned by M8. `enum J { Num(i64), Arr(Vec<J>) }` is
//     accepted as a declaration; `Vec::new()` is "Undefined enum type: Vec".
//     THIS, not the recursion, is what keeps the arena alive.
//   * `(String, Json)` is N4-12, owned by M2 — tuples do not parse.
//
// So the tree lives in a fixed-capacity arena of parallel arrays inside one
// struct, addressed by i64 index, with -1 for "none". Exceeding the capacity is
// a parse error rather than a wrong answer.
// ---------------------------------------------------------------------------

struct Json {
    src: String,
    len: i64,
    pos: i64,
    depth: i64,

    ok: bool,
    err: String,
    err_pos: i64,

    kind: [i64; 192],
    // Numeric value. Meaningful only where `exact` is 1 — see js_number.
    num: [i64; 192],
    exact: [i64; 192],
    // For strings: the decoded value. For numbers: the source lexeme.
    text: [String; 192],
    // For a member of an object: its key. Empty for array elements and the root.
    key: [String; 192],
    first: [i64; 192],
    last: [i64; 192],
    next: [i64; 192],
    count: i64,
}

// ---------------------------------------------------------------------------
// Cursor.
//
// WORKAROUND UNOWNED (codegen) + N9-01: every function below takes
// `mut j: Json` even when it only READS the document, and every call is
// `js_thing(j, ...)` rather than `j.thing(...)`.
//
// Two separate refusals force that, and the second one is a live miscompile:
//   * A NON-`mut` struct parameter is a move: `fn get(p: P)` called twice on the
//     same local is "Use of moved value: p". So a reader cannot take `j: Json`.
//   * The shared-borrow spelling that would fix it, `fn get(p: &Json)`, works
//     one level deep and CANNOT BE FORWARDED. `fn a(p: &P) -> i64 { return b(p); }`
//     with `fn b(p: &P)` emits `b((*p))` — it dereferences a pointer into a
//     value parameter — passes the type checker and the borrow checker, and is
//     caught only by gcc: "passing 'const struct P' to parameter of incompatible
//     type 'const struct P *'". A recursive-descent parser is nothing but
//     forwarding, so `&Json` is unusable here. No row owns the `&` spelling at
//     all: N4-13/N9-01/N9-02 name `ref T`/`ref mut T` and are owned by M7.
//
// WORKAROUND N5-17: method call syntax `j.peek()` is "Indirect function calls
// not yet supported", so all of this is free functions with an explicit
// receiver argument.
// ---------------------------------------------------------------------------

// N4-04: the cursor speaks `char`. Its end-of-input answer used to be -1, an
// integer outside the char domain that only worked while a char WAS an integer.
// NUL is the better answer and always was: `j.src` is a NUL-terminated C string,
// so `'\0'` cannot occur inside it, and every comparison below fails against it
// exactly as -1 did.
fn js_at(mut j: Json, i: i64) -> char {
    if i < 0 { return '\0'; }
    if i >= j.len { return '\0'; }
    return string_char_at(j.src, i);
}

fn js_peek(mut j: Json) -> char {
    return js_at(j, j.pos);
}

fn js_bump(mut j: Json) {
    // WORKAROUND N5-13: no compound assignment. `j.pos += 1;` is
    // "Expected expression, but found '='".
    j.pos = j.pos + 1;
}

fn js_fail(mut j: Json, msg: String) -> i64 {
    if j.ok {
        j.ok = false;
        j.err = msg;
        j.err_pos = j.pos;
    }
    return -1;
}

fn js_is_ws(c: char) -> bool {
    // WORKAROUND N6-07: the arm this replaces is
    // `' ' | '\t' | '\n' | '\r' => …`. Or-patterns do not exist, and neither do
    // the literal patterns (N6-02) they would be made of, so a `match` on a
    // byte cannot dispatch at all — it is boolean helpers and `if` all the way
    // down in this file.
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

fn js_is_digit(c: char) -> bool {
    // WORKAROUND N6-03: the arm this replaces is `'0'..='9' => …`.
    return c >= '0' && c <= '9';
}

fn js_skip_ws(mut j: Json) {
    // WORKAROUND N5-07: `loop { … }` is not a keyword — `loop` lexes as an
    // identifier, so `loop {` is "Expected ';' after expression, but found '{'".
    while true {
        if js_is_ws(js_peek(j)) {
            js_bump(j);
        } else {
            return;
        }
    }
}

// ---------------------------------------------------------------------------
// Arena.
// ---------------------------------------------------------------------------

fn js_alloc(mut j: Json, kind: i64) -> i64 {
    if j.count >= CAP_NODES {
        return js_fail(j, "document has more than 192 nodes");
    }
    let i: i64 = j.count;
    j.count = j.count + 1;
    j.kind[i] = kind;
    j.num[i] = 0;
    j.exact[i] = 0;
    j.text[i] = "";
    j.key[i] = "";
    j.first[i] = -1;
    j.last[i] = -1;
    j.next[i] = -1;
    return i;
}

fn js_append(mut j: Json, parent: i64, child: i64) {
    if j.last[parent] < 0 {
        j.first[parent] = child;
    } else {
        j.next[j.last[parent]] = child;
    }
    j.last[parent] = child;
}

// ---------------------------------------------------------------------------
// Strings.
// ---------------------------------------------------------------------------

fn js_hex_digit(c: char) -> i64 {
    if js_is_digit(c) { return c as i64 - '0' as i64; }
    // WORKAROUND N5-06: `else if` does not exist — after `else` the parser
    // demands `{`. Every multi-way test in this file is a nested `else { if … }`
    // staircase, and this is the cheapest example of it.
    else {
        if c >= 'a' && c <= 'f' {
            return c as i64 - 'a' as i64 + 10;
        } else {
            if c >= 'A' && c <= 'F' {
                return c as i64 - 'A' as i64 + 10;
            } else {
                return -1;
            }
        }
    }
}

fn js_hex4(mut j: Json) -> i64 {
    let mut v: i64 = 0;
    let mut k: i64 = 0;
    while k < 4 {
        let d: i64 = js_hex_digit(js_peek(j));
        if d < 0 {
            return js_fail(j, "\\u needs four hexadecimal digits");
        }
        // WORKAROUND N5-12: this is `(v << 4) | d`. `<<` is "Expected
        // expression, but found '<'"; `|` and `&` end the enclosing expression;
        // `^` is not even a character the lexer knows: "Unexpected character
        // '^'". Multiplication and addition compute the same value here only
        // because the operands are known to be in range.
        v = v * 16 + d;
        js_bump(j);
        k = k + 1;
    }
    return v;
}

fn js_utf8(cp: i64) -> String {
    // WORKAROUND N5-12 again: the shifts and masks of UTF-8 encoding, written
    // as division and remainder. `cp >> 6` is `cp / 64`, `cp & 63` is `cp % 64`.
    if cp < 128 {
        return string_from_char(cp as char);
    }
    if cp < 2048 {
        let b1: String = string_from_char((192 + cp / 64) as char);
        let b2: String = string_from_char((128 + cp % 64) as char);
        return string_concat(b1, b2);
    }
    if cp < 65536 {
        let c1: String = string_from_char((224 + cp / 4096) as char);
        let c2: String = string_from_char((128 + cp / 64 % 64) as char);
        let c3: String = string_from_char((128 + cp % 64) as char);
        return string_concat(string_concat(c1, c2), c3);
    }
    let d1: String = string_from_char((240 + cp / 262144) as char);
    let d2: String = string_from_char((128 + cp / 4096 % 64) as char);
    let d3: String = string_from_char((128 + cp / 64 % 64) as char);
    let d4: String = string_from_char((128 + cp % 64) as char);
    return string_concat(string_concat(string_concat(d1, d2), d3), d4);
}

// Takes a `char` and answers a CODE POINT, or -1 for "not a simple escape".
// The return stays `i64` because -1 has to be outside the char domain to mean
// what it means, and the two callers test it with `>= 0`.
fn js_simple_escape(e: char) -> i64 {
    if e == '"' { return '"' as i64; }
    if e == '\\' { return '\\' as i64; }
    if e == '/' { return '/' as i64; }
    if e == 'b' { return ch_backspace() as i64; }
    if e == 'f' { return ch_formfeed() as i64; }
    if e == 'n' { return '\n' as i64; }
    if e == 'r' { return '\r' as i64; }
    if e == 't' { return '\t' as i64; }
    return -1;
}

fn js_unicode_escape(mut j: Json) -> String {
    // Precondition: the cursor sits on the `u`.
    js_bump(j);
    let hi: i64 = js_hex4(j);
    if !j.ok { return ""; }
    if hi >= 55296 && hi <= 56319 {
        // High surrogate: RFC 8259 requires the low half to follow.
        if js_peek(j) != '\\' {
            js_fail(j, "high surrogate is not followed by a low surrogate");
            return "";
        }
        js_bump(j);
        if js_peek(j) != 'u' {
            js_fail(j, "high surrogate is not followed by a low surrogate");
            return "";
        }
        js_bump(j);
        let lo: i64 = js_hex4(j);
        if !j.ok { return ""; }
        if lo < 56320 || lo > 57343 {
            js_fail(j, "high surrogate is not followed by a low surrogate");
            return "";
        }
        // (hi - 0xD800) << 10 | (lo - 0xDC00), plus 0x10000 — see N5-12 above.
        let cp: i64 = 65536 + (hi - 55296) * 1024 + (lo - 56320);
        return js_utf8(cp);
    }
    if hi >= 56320 && hi <= 57343 {
        js_fail(j, "low surrogate with no high surrogate");
        return "";
    }
    if hi == 0 {
        // WORKAROUND UNOWNED: `String` is a NUL-terminated C `char*`
        // (`__pd_string_from_char` writes `result[0] = (char)c; result[1] = '\0';`),
        // so a document containing \u0000 cannot be represented, only refused.
        // No requirement row says what `String` is at the byte level; N4-05 is
        // one word, `String`, and is marked satisfied.
        js_fail(j, "\\u0000 is not representable in a NUL-terminated String");
        return "";
    }
    return js_utf8(hi);
}

fn js_string_body(mut j: Json) -> String {
    // Precondition: the cursor sits on the opening quote.
    js_bump(j);
    let mut out: String = "";
    while true {
        let c: char = js_peek(j);
        if c == '\0' {
            js_fail(j, "unterminated string");
            return "";
        }
        if c == '"' {
            js_bump(j);
            return out;
        }
        if c < ' ' {
            js_fail(j, "unescaped control character in string");
            return "";
        }
        if c == '\\' {
            js_bump(j);
            let e: char = js_peek(j);
            if e == '\0' {
                js_fail(j, "unterminated escape");
                return "";
            }
            let simple: i64 = js_simple_escape(e);
            if simple >= 0 {
                js_bump(j);
                out = string_concat(out, string_from_char(simple as char));
            } else {
                if e == 'u' {
                    let decoded: String = js_unicode_escape(j);
                    if !j.ok { return ""; }
                    out = string_concat(out, decoded);
                } else {
                    js_fail(j, "unknown escape");
                    return "";
                }
            }
        } else {
            js_bump(j);
            out = string_concat(out, string_from_char(c));
        }
    }
    return "";
}

// ---------------------------------------------------------------------------
// Values.
// ---------------------------------------------------------------------------

fn js_literal(mut j: Json, word: String, kind: i64) -> i64 {
    let n: i64 = string_len(word);
    let mut i: i64 = 0;
    while i < n {
        if js_at(j, j.pos + i) != string_char_at(word, i) {
            return js_fail(j, string_concat("expected ", word));
        }
        i = i + 1;
    }
    j.pos = j.pos + n;
    return js_alloc(j, kind);
}

fn js_number(mut j: Json) -> i64 {
    let start: i64 = j.pos;
    let mut integral: bool = true;

    if js_peek(j) == '-' { js_bump(j); }

    if js_peek(j) == '0' {
        js_bump(j);
    } else {
        if js_is_digit(js_peek(j)) {
            while js_is_digit(js_peek(j)) { js_bump(j); }
        } else {
            return js_fail(j, "expected a digit");
        }
    }

    if js_peek(j) == '.' {
        integral = false;
        js_bump(j);
        if !js_is_digit(js_peek(j)) {
            return js_fail(j, "expected a digit after '.'");
        }
        while js_is_digit(js_peek(j)) { js_bump(j); }
    }

    let e: char = js_peek(j);
    if e == 'e' || e == 'E' {
        integral = false;
        js_bump(j);
        let s: char = js_peek(j);
        if s == '+' || s == '-' { js_bump(j); }
        if !js_is_digit(js_peek(j)) {
            return js_fail(j, "expected a digit in the exponent");
        }
        while js_is_digit(js_peek(j)) { js_bump(j); }
    }

    let node: i64 = js_alloc(j, k_number());
    if node < 0 { return -1; }
    let lexeme: String = string_substring(j.src, start, j.pos);
    j.text[node] = lexeme;
    // WORKAROUND UNOWNED: `f64` EXISTS. N4-02 is `satisfied` in
    // docs/contributing/1.0-requirements.tsv, and `let x: f64 = 1.5;` with
    // arithmetic and comparisons on it compiles. What is missing is any way to
    // move a float ACROSS the text boundary: `src/builtins.rs` declares no
    // `string_to_float` and no `float_to_string` — grep for `float` in that
    // file matches nothing at all — and N14's builtin set is closed, so NO
    // requirement row owns them. So a non-integral number has no value in this
    // program, only its source lexeme, which is what js_render prints. `exact`
    // records which is which, so a query for a numeric value can refuse rather
    // than return the truncated integer part.
    if integral {
        j.exact[node] = 1;
        j.num[node] = string_to_int(lexeme);
    }
    return node;
}

fn js_array(mut j: Json) -> i64 {
    js_bump(j);
    let node: i64 = js_alloc(j, k_array());
    if node < 0 { return -1; }
    js_skip_ws(j);
    if js_peek(j) == ']' {
        js_bump(j);
        return node;
    }
    while true {
        let child: i64 = js_value(j);
        if child < 0 { return -1; }
        js_append(j, node, child);
        js_skip_ws(j);
        let c: char = js_peek(j);
        if c == ',' {
            js_bump(j);
            js_skip_ws(j);
        } else {
            if c == ']' {
                js_bump(j);
                return node;
            } else {
                return js_fail(j, "expected ',' or ']'");
            }
        }
    }
    return -1;
}

fn js_object(mut j: Json) -> i64 {
    js_bump(j);
    let node: i64 = js_alloc(j, k_object());
    if node < 0 { return -1; }
    js_skip_ws(j);
    if js_peek(j) == '}' {
        js_bump(j);
        return node;
    }
    while true {
        js_skip_ws(j);
        if js_peek(j) != '"' {
            return js_fail(j, "expected a member name");
        }
        let name: String = js_string_body(j);
        if !j.ok { return -1; }
        js_skip_ws(j);
        if js_peek(j) != ':' {
            return js_fail(j, "expected ':'");
        }
        js_bump(j);
        let child: i64 = js_value(j);
        if child < 0 { return -1; }
        j.key[child] = name;
        js_append(j, node, child);
        js_skip_ws(j);
        let c: char = js_peek(j);
        if c == ',' {
            js_bump(j);
        } else {
            if c == '}' {
                js_bump(j);
                return node;
            } else {
                return js_fail(j, "expected ',' or '}'");
            }
        }
    }
    return -1;
}

fn js_value(mut j: Json) -> i64 {
    if !j.ok { return -1; }
    j.depth = j.depth + 1;
    if j.depth > MAX_DEPTH {
        j.depth = j.depth - 1;
        return js_fail(j, "nesting deeper than 24");
    }
    js_skip_ws(j);
    let c: char = js_peek(j);
    let mut node: i64 = -1;

    // WORKAROUND N5-04 + N6-02: the whole of this staircase is one `match` on a
    // byte in any language with literal patterns, and `match` here is an
    // EXPRESSION whose value is the node. Neither exists: `match` in expression
    // position is "Expected expression, but found 'match'", and an integer arm
    // is "Expected pattern, but found integer 0". So: an `if` staircase, a
    // mutable local, and one assignment per arm.
    if c == '\0' {
        node = js_fail(j, "unexpected end of input");
    } else {
        if c == 'n' {
            node = js_literal(j, "null", k_null());
        } else {
            if c == 't' {
                node = js_literal(j, "true", k_true());
            } else {
                if c == 'f' {
                    node = js_literal(j, "false", k_false());
                } else {
                    if c == '"' {
                        let decoded: String = js_string_body(j);
                        if j.ok {
                            node = js_alloc(j, k_string());
                            if node >= 0 { j.text[node] = decoded; }
                        }
                    } else {
                        if c == '[' {
                            node = js_array(j);
                        } else {
                            if c == '{' {
                                node = js_object(j);
                            } else {
                                if c == '-' || js_is_digit(c) {
                                    node = js_number(j);
                                } else {
                                    node = js_fail(j, "unexpected character");
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    j.depth = j.depth - 1;
    return node;
}

fn js_parse(mut j: Json, src: String) -> i64 {
    j.src = src;
    j.len = string_len(src);
    j.pos = 0;
    j.depth = 0;
    j.ok = true;
    j.err = "";
    j.err_pos = 0;
    j.count = 0;

    let root: i64 = js_value(j);
    if root < 0 { return -1; }
    js_skip_ws(j);
    if j.pos != j.len {
        return js_fail(j, "trailing content after the document");
    }
    return root;
}

// ---------------------------------------------------------------------------
// Rendering — canonical re-serialisation, so the transcript shows the TREE and
// not the input echoed back.
// ---------------------------------------------------------------------------

fn js_escape_into(s: String) -> String {
    let n: i64 = string_len(s);
    let mut out: String = "";
    let mut i: i64 = 0;
    while i < n {
        let c: char = string_char_at(s, i);
        if c == '"' {
            out = string_concat(out, "\\\"");
        } else {
            if c == '\\' {
                out = string_concat(out, "\\\\");
            } else {
                if c == '\n' {
                    out = string_concat(out, "\\n");
                } else {
                    if c == '\r' {
                        out = string_concat(out, "\\r");
                    } else {
                        if c == '\t' {
                            out = string_concat(out, "\\t");
                        } else {
                            if c == ch_backspace() {
                                out = string_concat(out, "\\b");
                            } else {
                                if c == ch_formfeed() {
                                    out = string_concat(out, "\\f");
                                } else {
                                    out = string_concat(out, string_from_char(c));
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

fn js_render(mut j: Json, node: i64) -> String {
    let k: i64 = j.kind[node];
    if k == k_null() { return "null"; }
    if k == k_false() { return "false"; }
    if k == k_true() { return "true"; }
    if k == k_number() { return j.text[node]; }
    if k == k_string() {
        let body: String = js_escape_into(j.text[node]);
        return string_concat(string_concat("\"", body), "\"");
    }
    if k == k_array() {
        let mut out: String = "[";
        let mut child: i64 = j.first[node];
        let mut first: bool = true;
        while child >= 0 {
            if !first { out = string_concat(out, ","); }
            first = false;
            out = string_concat(out, js_render(j, child));
            child = j.next[child];
        }
        return string_concat(out, "]");
    }
    let mut out2: String = "{";
    let mut member: i64 = j.first[node];
    let mut first2: bool = true;
    while member >= 0 {
        if !first2 { out2 = string_concat(out2, ","); }
        first2 = false;
        let name: String = js_escape_into(j.key[member]);
        out2 = string_concat(out2, string_concat(string_concat("\"", name), "\":"));
        out2 = string_concat(out2, js_render(j, member));
        member = j.next[member];
    }
    return string_concat(out2, "}");
}

// ---------------------------------------------------------------------------
// Queries.
// ---------------------------------------------------------------------------

fn js_member(mut j: Json, node: i64, name: String) -> i64 {
    if j.kind[node] != k_object() { return -1; }
    let mut child: i64 = j.first[node];
    while child >= 0 {
        if string_eq(j.key[child], name) { return child; }
        child = j.next[child];
    }
    return -1;
}

fn js_element(mut j: Json, node: i64, index: i64) -> i64 {
    if j.kind[node] != k_array() { return -1; }
    let mut child: i64 = j.first[node];
    let mut i: i64 = 0;
    while child >= 0 {
        if i == index { return child; }
        i = i + 1;
        child = j.next[child];
    }
    return -1;
}

fn js_length(mut j: Json, node: i64) -> i64 {
    let mut child: i64 = j.first[node];
    let mut n: i64 = 0;
    while child >= 0 {
        n = n + 1;
        child = j.next[child];
    }
    return n;
}

fn js_kind_name(mut j: Json, node: i64) -> String {
    if node < 0 { return "absent"; }
    let k: i64 = j.kind[node];
    if k == k_null() { return "null"; }
    if k == k_false() { return "bool"; }
    if k == k_true() { return "bool"; }
    if k == k_number() { return "number"; }
    if k == k_string() { return "string"; }
    if k == k_array() { return "array"; }
    return "object";
}

// ---------------------------------------------------------------------------
// Driver.
// ---------------------------------------------------------------------------

fn show_ok(mut j: Json, label: String, src: String) {
    let root: i64 = js_parse(j, src);
    if root < 0 {
        print(string_concat(string_concat(label, " UNEXPECTED ERROR "), j.err));
        return;
    }
    print(string_concat(string_concat(label, " "), js_render(j, root)));
}

fn show_err(mut j: Json, label: String, src: String) {
    let root: i64 = js_parse(j, src);
    if root >= 0 {
        print(string_concat(label, " UNEXPECTEDLY ACCEPTED"));
        return;
    }
    let at: String = int_to_string(j.err_pos);
    print(string_concat(string_concat(string_concat(label, " at "), at), string_concat(": ", j.err)));
}

fn main() {
    let mut j: Json = Json {
        src: "",
        len: 0,
        pos: 0,
        depth: 0,
        ok: true,
        err: "",
        err_pos: 0,
        kind: [0; 192],
        num: [0; 192],
        exact: [0; 192],
        text: [""; 192],
        key: [""; 192],
        first: [0; 192],
        last: [0; 192],
        next: [0; 192],
        count: 0,
    };

    print("-- accepted --");
    show_ok(j, "scalars   ", "[null, true, false, 0, -17, 3.25, 1e3, 2E-2]");
    show_ok(j, "strings   ", "[\"\", \"a\\\"b\", \"sl\\/ash\", \"\\u0041\\u00e9\\u20ac\"]");
    show_ok(j, "surrogate ", "[\"\\ud83d\\ude00\"]");

    show_ok(j, "tab escape", "[\"tab\\there\"]");
    show_ok(j, "nesting   ", "{\"a\":{\"b\":[1,[2,[3,{}]]]},\"c\":[]}");
    show_ok(j, "whitespace", "  {  \"k\"  :  [ 1 , 2 ]  }  ");
    show_ok(j, "dup keys  ", "{\"k\":1,\"k\":2}");

    print("-- queries --");
    let doc: i64 = js_parse(j, "{\"name\":\"pd\",\"tags\":[\"a\",\"b\",\"c\"],\"n\":42,\"ratio\":0.5}");
    print(string_concat("root kind      ", js_kind_name(j, doc)));
    print(string_concat("member count   ", int_to_string(js_length(j, doc))));
    print(string_concat("name           ", j.text[js_member(j, doc, "name")]));
    let tags: i64 = js_member(j, doc, "tags");
    print(string_concat("tags length    ", int_to_string(js_length(j, tags))));
    print(string_concat("tags[1]        ", j.text[js_element(j, tags, 1)]));
    let n: i64 = js_member(j, doc, "n");
    print(string_concat("n              ", int_to_string(j.num[n])));
    let ratio: i64 = js_member(j, doc, "ratio");
    print(string_concat("ratio lexeme   ", j.text[ratio]));
    // The UNOWNED float↔text boundary gap again, as an observable: only text, no
    // value. Nothing turns the lexeme "0.5" into an f64, and nothing would print
    // one back out, so `exact` is 0 and the lexeme is all this program can carry.
    print(string_concat("ratio exact    ", int_to_string(j.exact[ratio])));
    // Downstream cost of the `mut j` workaround above: `js_kind_name` only
    // reads, but it takes `mut`, so nesting the two calls is two mutable
    // borrows of `j` in one expression and the borrow checker is RIGHT to
    // refuse it ("Conflicting borrows: cannot borrow `j` because it is already
    // mutably borrowed"). With a shared borrow this line would not need a temp.
    let missing: i64 = js_member(j, doc, "nope");
    print(string_concat("missing        ", js_kind_name(j, missing)));
    print(string_concat("nodes used     ", int_to_string(j.count)));

    print("-- refused --");
    show_err(j, "empty        ", "");
    show_err(j, "trailing     ", "1 2");
    show_err(j, "unterminated ", "\"abc");
    show_err(j, "control char ", "\"a\tb\"");
    show_err(j, "bad escape   ", "\"a\\qb\"");
    show_err(j, "short \\u     ", "\"\\u12\"");
    show_err(j, "lone surrog. ", "\"\\ud83d\"");
    show_err(j, "nul escape   ", "\"\\u0000\"");
    show_err(j, "leading zero ", "01");
    show_err(j, "bare dot     ", "1.");
    show_err(j, "no exponent  ", "1e");
    show_err(j, "missing comma", "[1 2]");
    show_err(j, "missing colon", "{\"a\" 1}");
    show_err(j, "bad member   ", "{a:1}");
    show_err(j, "junk         ", "@");
}
