// Test 02: COMPARISON OPERATORS, ON EVERY OPERAND TYPE THAT HAS A COMPARISON
// (N5-10, #89, #92).
//
// `==` `!=` `<` `<=` `>` `>=` apply to the integers, the floats, `bool` and
// `char` — the types whose C carrier compares as the values do — and to aliases
// of those. Every other operand type is refused by name (PD0080; the six
// tests/reject/comparison_*.pd rows), each with the way to compare instead, and
// this fixture runs those ways too: a struct field by field, a tuple and an array
// element by element, an enum with `match`, a String with `string_eq`.
//
// Every digit below is the digit d5166e8 printed for the same program: the
// refusal took nothing away from the types that compared correctly.

type N = i64;
type B = bool;
type C = char;
type F = f64;

struct P {
    x: i64,
    y: i64,
}

enum K {
    A,
    B,
}

fn b(x: bool) {
    if x {
        print_int(1);
    } else {
        print_int(0);
    }
}

fn m32(v: i32) -> i32 { v }
fn mu32(v: u32) -> u32 { v }
fn mu64(v: u64) -> u64 { v }

// A reference PARAMETER: code generation reads through it on every use, so this
// is a comparison of the two integers, not of their addresses.
fn eq(a: &i64, c: &i64) -> bool { a == c }

fn is_a(k: K) -> bool {
    match k {
        K::A => true,
        K::B => false,
    }
}

// A generic body, checked at each instantiation: at `i64` and at `bool` it has a
// comparison, and it runs.
fn same<T>(a: T, c: T) -> bool { a == c }

fn main() {
    print("integers:");
    let a = 3;
    let c = 4;
    b(a == c); b(a != c); b(a < c); b(a <= c); b(a > c); b(a >= c);
    let i: i32 = m32(5);
    let j: i32 = m32(7);
    b(i < j); b(i == j);
    let u: u32 = mu32(4000000000);
    let v: u32 = mu32(1);
    b(u > v);
    let w: u64 = mu64(3);
    let x: u64 = mu64(3);
    b(w == x);

    print("bool, char, f64:");
    let t = true;
    let f = false;
    b(t == f); b(f < t); b(t != f);
    let p = 'a';
    let q = 'b';
    b(p == q); b(p < q); b(q >= 'b');
    let g = 1.5;
    let h = 2.5;
    b(g == h); b(g < h); b(h >= 2.5);

    print("aliases:");
    let n: N = 3;
    b(n == 3); b(n < 4);
    let y: B = true;
    let z: C = 'q';
    let e: F = 2.0;
    b(y == true); b(z == 'q'); b(e < 3.0);

    print("through a reference parameter:");
    let r = 5;
    let s = 5;
    b(eq(&r, &s));

    print("the ways to compare what has no comparison:");
    let pa = P { x: 1, y: 2 };
    let pb = P { x: 1, y: 2 };
    b(pa.x == pb.x && pa.y == pb.y);
    let ta = (1, 2);
    let tb = (1, 3);
    b(ta.0 == tb.0 && ta.1 == tb.1);
    let aa = [1, 2];
    let ab = [1, 2];
    b(aa[0] == ab[0] && aa[1] == ab[1]);
    b(is_a(K::A)); b(is_a(K::B));
    b(string_eq(int_to_string(12), "12"));

    print("generic, at a type with a comparison:");
    b(same(1, 1)); b(same(true, false));

    print("in a for, a guard and a while:");
    let mut acc = 0;
    for k in 0..4 {
        if k != 2 {
            acc = acc + k;
        }
    }
    print_int(acc);
    match r {
        m if m > 2 => { print_int(m); }
        _ => { print_int(0); }
    }
    let mut count = 0;
    while count < 3 {
        count = count + 1;
    }
    print_int(count);
}
