// A macro invocation inside a VALUE position expands, compiles and runs
// (N5-03/N5-05, and the macro expander's walk over them).
//
// The expander's expression walker had no arm for `Expr::If`/`Block`/`Loop`/
// `Match`, so an invocation inside one fell through its catch-all and was left
// in the tree, reaching a code generator documented never to see a macro. The
// negative half of that is pinned by unit tests; this is the positive half —
// the value the program actually prints.
//
// THE MACROS TAKE NO PARAMETERS ON PURPOSE, and the reason has CHANGED since
// this comment was written. It used to say a parameter is never substituted and
// quoted "Undefined variable or function: 'x'" — true at the time, because `$`
// was missing from the parser's token table so no macro had ever substituted
// anything. N3-12 fixed that: `macro double!(x) { $x * 2 }` works and
// `tests/03_macros.pd` pins it. What the quoted spelling now gets is a
// DEFINITION-SIDE refusal, because a body that writes the bare parameter name
// resolves it at the call site: "macro `double` writes `x` in its body, which
// is the name of a parameter but is not a substitution: write `$x`".
// These macros stay parameterless because this fixture is about the EXPANDER'S
// WALK over value positions, and a parameter would add a second subject.

enum Pick {
    First,
    Second,
}

macro forty_two!() {
    42
}

macro one_hundred!() {
    100
}

fn main() {
    print("A macro in each branch of a value if:");
    let a = if 1 < 2 { forty_two!() } else { one_hundred!() };
    print_int(a);

    print("...and the other branch, so both are really expanded:");
    let b = if 1 > 2 { forty_two!() } else { one_hundred!() };
    print_int(b);

    print("A macro as the tail of a value block:");
    let c = { forty_two!() };
    print_int(c);

    print("A macro inside a value block inside a value if:");
    let d = if 2 > 1 { { one_hundred!() } } else { { 0 } };
    print_int(d);

    print("A macro in a value loop's break:");
    let e = loop { break forty_two!(); };
    print_int(e);

    print("A macro in a value match arm:");
    let k = Pick::Second;
    let f = match k {
        Pick::First => forty_two!(),
        Pick::Second => one_hundred!(),
    };
    print_int(f);
}
