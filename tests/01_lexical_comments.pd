// Test 01: Lexical Structure - Comments
// This file tests various comment styles

// Single line comment
fn main() {
    // Comment before statement
    print("Testing comments");
    
    print("Inline comment test"); // This is an inline comment
    
    /* Block comment on single line */
    print("After block comment");
    
    /* 
     * Multi-line
     * block comment
     * with multiple lines
     */
    print("After multi-line block");
    
    /* Block comments NEST (N2-08). The inner close below ends the INNER
       comment, not this one, so the print on the next line stays commented
       out. Before N2-08 the regex scanner stopped at the first close and this
       file failed to compile with `Expected expression, but found '/'`.
       /* inner */
       print("wrong");
    */
    print("After nested block comment");

    /* /* /* three deep */ */ */
    print("After three-deep nesting");
    
    let x = 42; // Comment after variable
    print_int(x);
    
    // Comment with special chars: @#$%^&*()_+-=[]{}|;':",./<>?
    
    /*
    let commented_out = "This won't compile";
    print(commented_out);
    */
    
    // A `/*` inside a STRING is not a comment opener, and a `*/` inside one
    // does not close a comment: the string rule wins because it starts first.
    print("not a comment: /* */");

    // Inline block comments not supported
    print("String without inline comment");
    
    // Unicode in comments: 한글 中文 🎉
    print("Comments test complete");
}