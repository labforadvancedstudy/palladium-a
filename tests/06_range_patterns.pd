// Test 06: RANGE PATTERNS (requirement N6-03) — `lo .. hi` and `lo ..= hi`.
//
// EXACTLY THE TWO FORMS THE SPEC NAMES. `docs/specification/grammar.ebnf`'s
// normative pattern production gives `expression ".." expression` and
// `expression "..=" expression`, both with two endpoints. Open-ended forms
// (`1..`, `..5`) are named nowhere, so they are refused BY NAME rather than
// invented here — `tests/reject/range_pattern_open_ended.pd`.
//
// ENDPOINTS ARE INTEGER LITERALS. The normative production says `expression`,
// which no pattern position in this compiler can evaluate; a `char` endpoint
// waits on N4-04, which owes `char` as a type at all. A non-integer endpoint is
// refused with its type named (`tests/reject/range_pattern_endpoint_type.pd`).
//
// AN EMPTY RANGE IS A DEFECT, NOT DEAD CODE. `5..=1` and `3..3` can never match,
// so a reader who wrote one meant something else; they are refused rather than
// compiled into an arm that is silently skipped
// (`tests/reject/range_pattern_empty.pd`).
//
// A range contributes NOTHING to exhaustiveness: `i64` is not enumerable by any
// finite set of ranges this checker could count, so every match below is
// exhausted by a catch-all. N6-10 is what makes that a rule rather than a habit.

enum P {
    Num(i64),
    Empty,
}

fn grade(n: i64) -> i64 {
    match n {
        0..=59 => 0,
        60..=79 => 1,
        80..=100 => 2,
        _ => 9,
    }
}

fn main() {
    print("Inclusive ranges pick their band:");
    print_int(grade(0));
    print_int(grade(59));
    print_int(grade(60));
    print_int(grade(100));
    print_int(grade(101));

    print("An exclusive range stops one short:");
    let e = match 5 {
        1..5 => 1,
        _ => 0,
    };
    print_int(e);
    let f = match 4 {
        1..5 => 1,
        _ => 0,
    };
    print_int(f);

    print("Negative endpoints:");
    let g = match -3 {
        -5..=-1 => 1,
        _ => 0,
    };
    print_int(g);
    let h = match 0 {
        -5..=-1 => 1,
        _ => 0,
    };
    print_int(h);

    print("A range with alternatives:");
    let i = match 8 {
        1..=3 | 7..=9 => 1,
        _ => 0,
    };
    print_int(i);
    let j = match 5 {
        1..=3 | 7..=9 => 1,
        _ => 0,
    };
    print_int(j);

    print("A range under a guard:");
    let k = match 12 {
        m if m > 100 => 1,
        10..=20 => 2,
        _ => 3,
    };
    print_int(k);

    print("A binding over a range, which binds AND tests:");
    let l = match 4 {
        n @ 1..=5 => n * 10,
        _ => 0,
    };
    print_int(l);
    let m = match 9 {
        n @ 1..=5 => n * 10,
        other => other,
    };
    print_int(m);

    print("A range inside an enum payload:");
    let o = match P::Num(7) {
        P::Num(1..=9) => 1,
        _ => 0,
    };
    print_int(o);
    let p = match P::Num(70) {
        P::Num(1..=9) => 1,
        _ => 0,
    };
    print_int(p);

    print("The minimum is a real bound, and the scrutinee here is POSITIVE:");
    // `i64::MIN` cannot be written as a C literal: `-9223372036854775808` is
    // unary minus applied to a constant that does not fit in `long long`, so it
    // takes an UNSIGNED type and `x >= <it>` degenerates into "is x negative".
    // Measured before the repair, this printed 0 — which a NEGATIVE scrutinee
    // would have hidden, because a negative x satisfies the broken test too.
    let lo = match 5 {
        -9223372036854775808..=10 => 1,
        _ => 0,
    };
    print_int(lo);
    let hi = match 11 {
        -9223372036854775808..=10 => 1,
        _ => 0,
    };
    print_int(hi);

    print("Statement form:");
    match 55 {
        0..=49 => { print("low"); }
        50..=99 => { print("high"); }
        _ => { print("off the scale"); }
    }
}
