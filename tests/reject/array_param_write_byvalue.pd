// NEGATIVE TEST -- writing through a by-value `[T; N]` parameter is refused.
//
// Whether a `[T; N]` parameter copies or aliases the caller's array is an OPEN
// DECISION in the specification (language-spec.md N12.1). C decides it for us
// by decaying every array parameter to a pointer, so a write here would reach
// the caller's array no matter which semantics the language later picks.
// Codegen refuses instead of guessing, and names both repairs.
//
// This row's evidence in feature-index.toml claimed the opposite -- "compiles,
// links, prints 99, no diagnostic" -- and was never executed by any gate. It had
// gone stale: the refusal exists.
fn bump(a: [i64; 3]) {
    a[0] = 99;
}

fn main() {
    let mut v: [i64; 3] = [1, 2, 3];
    bump(v);
    print_int(v[0]);
}
