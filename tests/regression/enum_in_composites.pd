// Regression test: a user enum inside every composite (N4-24; N4-09 and N4-10
// are instance claims beside it). This fixture is N4-24's evidence: the row was
// added 2026-11-08 from issue #46, because no row named what this file runs.
// An array of an enum as a local (both literal forms), a parameter, a
// reference parameter, a struct field, nested, walked by `for` and written
// through an index; a tuple and a reference carrying one; a method signature
// naming one, `&self` matched inside `impl` for one; a generic function
// instantiated at one.
//
// None of this compiled before. The type checker decided enum-or-struct for a
// bare `K` and called the `K` inside `[K; 4]`, `(K, i64)`, `&K`, a method
// signature and a generic instantiation a STRUCT, while every expression
// producing a `K` was an enum, so each line below was refused with one type
// named on both sides: `Type mismatch: expected [K; 4], found [K; 4]`.
//
// Every value printed is a variant code (0, 1, 2), so a wrong index or a
// wrong variant is a wrong number rather than a silent pass.
//
// Review round 1 added two sections. TYPE PARAMETERS FIRST: a generic struct's
// `[P; 2]` and a generic function's `(P, i64)` are substituted even though a
// global `enum P` exists — on af5d6ac the struct's `P` was read as that enum,
// so an array of it type-checked into an `i64` slot and gcc refused the C.
// ALIASES OF ARRAYS: `type KA = [K; 2]` and friends are declared as the array
// they name; every one printed `long long[2] xs` (brackets before the name)
// and gcc refused it, for `[i64; 2]` and `[S; 2]` on 2563001 too.
//
// Review round 2 added A PARAMETER IS NOT AN ALIAS: `struct Wide<Wd>` beside
// `type Wd = bool;` is instantiated at `i64`, and f841b99 expanded the field's
// `Wd` as the alias before monomorphising, so `Wide { v: 4294967297 }` printed
// `1` with exit 0 — a silent wrong answer this transcript now pins.
//
// Review round 6 added AN ALIAS MAIN TYPED BY ITS NAME. A `u32` alias that a
// generic function or a method returns is handed to another generic at the
// alias, as main handed it, so `~7` is the `u32` complement 4294967288: on
// 40efcf3 the value was the type the alias names, which this checker spells
// `Int` for every width, the generic was instantiated at `i64`, and both
// programs ran and printed -8. A binding annotated with that alias keeps it.
// And an element of an array written with a tuple alias, assigned a
// generic's result, runs as on main: it was refused as `expected B, found
// (Int, Int)`, because the assignment compared with `!=` what the `let`
// admits.
//
// Review round 7 added A NAME MEETS ITS VALUE and A REFERENCE ALIAS IS A
// VALUE. An element of `[Wn; 2]` is the NAME `Wn`, a generic's result the
// `u32` declared as `Wn`; main typed both as the name, so an `if`, an array
// literal and a comparison over the two ran, and so did re-assigning an
// element of `[Pair; 2]` to a binding of a generic's `Pair`. On 1dad901 each
// was refused (`expected both branches of this `if` to have type Wn, found
// an `else` branch of type Int`). And `type Rf = &i64`, passed to and
// returned from a function and held in a struct's field, ran on main as a
// pointer passed by value; on 1dad901 `return r0;` was emitted
// `return (*r0);` (gcc refused it) and the field was refused as a reference
// in a struct.
//
// Review round 8 added ONE ALIAS, ONE TYPE. Two values main typed by the
// names of two aliases are one type only if the aliases name one type in the
// source: on 144a493 a `&i64` alias's value and a `&u32` alias's were one
// `Int` and reached C as two pointer types (main refused them by name, and
// so does this compiler now — a refusal, which this fixture cannot run).
// What runs is what main ran: two values of `Rf` given to one generic's
// `U` and merged by an `if`, and a literal at `Wn` where main read `Wn` as
// the `u32` it names — an annotation, and an assignment into it.

enum K {
    A,
    B,
    C,
}

fn kcode(k: K) -> i64 {
    match k {
        K::A => { return 0; }
        K::B => { return 1; }
        K::C => { return 2; }
    }
}

struct Hand {
    ks: [K; 3],
    n: i64,
}

impl Hand {
    fn code_of(&self, k: K) -> i64 {
        return kcode(k) + self.n;
    }
}

impl K {
    fn code(&self) -> i64 {
        match self {
            K::A => { return 10; }
            K::B => { return 11; }
            K::C => { return 12; }
        }
    }
}

fn first(ks: [K; 3]) -> i64 {
    return kcode(ks[0]);
}

fn second(ks: &[K; 3]) -> i64 {
    return kcode(ks[1]);
}

fn by_ref(k: &K) -> i64 {
    match k {
        K::A => { return 20; }
        K::B => { return 21; }
        K::C => { return 22; }
    }
}

fn id<T>(x: T) -> T {
    return x;
}

enum P {
    X,
    Y,
}

struct Gp<P> {
    v: P,
    k: [P; 2],
}

fn tsecond<P>(x: P, t: (P, i64)) -> i64 {
    return t.1;
}

struct Seat {
    n: i64,
}

type IA = [i64; 2];
type SA = [Seat; 2];
type KA = [K; 2];
type KB = KA;
type KT = (K, i64);

struct Row {
    xs: IA,
    n: i64,
}

fn last_of(xs: IA) -> i64 {
    return xs[1];
}

type Wd = bool;

struct Wide<Wd> {
    v: Wd,
}

type Wn = u32;

fn wnot<U>(u: U) -> i64 {
    return ~u;
}

fn wmake<T>(t: T) -> Wn {
    return 7;
}

impl Seat {
    fn wn(&self) -> Wn {
        return 7;
    }
}

type Pair = (i64, i64);

fn pmake<T>(t: T) -> Pair {
    return (4294967297, 8);
}

fn pfirst<X>(x: X) -> i64 {
    return x.0;
}

type Rf = &i64;

fn rpass(r0: Rf) -> Rf {
    return r0;
}

struct Holder {
    p: Rf,
}

struct Cell {
    n: i64,
}

impl Cell {
    fn at(&self) -> Rf {
        return &self.n;
    }
}

fn rboth<U>(x: U, y: U) -> U {
    return x;
}

fn rnot<U>(u: U) -> i64 {
    return ~(*u);
}

fn lnot<U>(u: U) -> i64 {
    return ~u;
}

// Review round 9: a generic struct's type argument is carried by the alias,
// as a generic function's is (one struct per alias, so each literal has one
// instantiation to be of).
struct Tagged<X, Y> {
    tag: X,
    p: Y,
}

struct Paired<X, Y> {
    tag: X,
    p: Y,
}

struct Narrow<X, Y> {
    tag: X,
    p: Y,
}

// Review round 10: a generic struct's literal is of the instantiation the type
// checker recorded for it, not of another literal's its values' C types match.
type wz = u32;

impl Seat {
    fn wz(&self) -> wz {
        return 7;
    }
}

struct Own<X, Y> {
    tag: X,
    p: Y,
}

// Review round 11: a literal is itself, not its span. Every expansion of a
// macro is parsed from offset 0, so its expansions are literals at one span.
macro own_of!(x) { Own { tag: 5, p: $x } }

fn main() {
    // Both literal forms against an annotation.
    let xs: [K; 4] = [K::B; 4];
    let ys: [K; 3] = [K::C, K::A, K::B];
    print("Local:");
    print_int(kcode(xs[3]));
    print_int(kcode(ys[0]));

    // As a parameter and behind a reference.
    print("\nParameter:");
    print_int(first(ys));
    print_int(second(&ys));

    // Written through an index, then walked.
    let mut zs: [K; 3] = [K::A, K::A, K::A];
    zs[1] = K::C;
    print("\nWalked:");
    for k in zs {
        print_int(kcode(k));
    }

    // Nested.
    let g: [[K; 2]; 2] = [[K::A, K::B], [K::C, K::A]];
    print("\nNested:");
    print_int(kcode(g[1][0]));
    print_int(kcode(g[0][1]));

    // A struct field, and a method whose signature names the enum.
    let h: Hand = Hand { ks: [K::B, K::C, K::A], n: 100 };
    print("\nField:");
    print_int(kcode(h.ks[1]));
    print_int(h.code_of(K::B));

    // A tuple component and a reference parameter.
    let t: (K, i64) = (K::C, 5);
    let r: K = K::B;
    print("\nTuple and reference:");
    print_int(kcode(t.0));
    print_int(by_ref(&r));

    // `&self` inside `impl K`, and a generic function instantiated at `K`.
    let m: K = K::A;
    print("\nMethod and generic:");
    print_int(m.code());
    let picked: K = id(r);
    print_int(kcode(picked));

    // A type parameter named like the global `enum P` is still the parameter.
    let gp = Gp { v: 3, k: [40, 41] };
    let pt: (i64, i64) = (7, 8);
    print("\nType parameters first:");
    print_int(gp.v);
    print_int(gp.k[1]);
    print_int(tsecond(5, pt));

    // Aliases of arrays, declared as the arrays they name.
    let ia: IA = [50, 51];
    let sa: SA = [Seat { n: 60 }, Seat { n: 61 }];
    let ka: KA = [K::C, K::A];
    let kb: KB = [K::B, K::C];
    let kt: KT = (K::C, 70);
    let row: Row = Row { xs: [80, 81], n: 82 };
    print("\nAliases:");
    print_int(ia[0]);
    print_int(sa[1].n);
    print_int(kcode(ka[0]));
    print_int(kcode(kb[0]));
    print_int(kcode(kt.0));
    print_int(kt.1);
    print_int(row.xs[1]);
    print_int(row.n);
    print_int(last_of(ia));

    // A type parameter named like a global alias is the parameter.
    let wide = Wide { v: 4294967297 };
    let flag: Wd = true;
    print("\nParameter, not alias:");
    print_int(wide.v);
    if flag {
        print_int(1);
    }

    // An alias a generic or a method returns is carried to a generic by name.
    let wr = wmake(1);
    let seat = Seat { n: 1 };
    let ws = seat.wn();
    let wy = wmake(2);
    let wz: Wn = wy;
    let mut pairs: [Pair; 2] = [pmake(1), pmake(2)];
    pairs[0] = pmake(3);
    let p0 = pairs[0];
    print("\nAlias carried by name:");
    print_int(wnot(wr));
    print_int(wnot(ws));
    print_int(wnot(wz));
    print_int(pfirst(p0));

    // An alias's name meets a value declared as it; a reference alias is a value.
    let named: [Wn; 2] = [wmake(3), wmake(4)];
    let wa = named[0];
    let wb = wmake(5);
    let wc = true;
    let wm = if wc { wa } else { wb };
    let wl = [wb, wa];
    let wl1 = wl[1];
    let wq = wa == wb;
    let mut pr = pmake(4);
    pr = pairs[1];
    let big = 4294967297;
    let rr = rpass(&big);
    let rz: Rf = rr;
    let hold = Holder { p: &big };
    print("\nName meets value:");
    print_int(wnot(wm));
    print_int(wnot(wl1));
    if wq {
        print_int(1);
    }
    print_int(pfirst(pr));
    print("\nReference alias:");
    print_int(*rz);
    print_int(*hold.p);

    // Two values of one reference alias are one type; a literal meets an alias
    // where main read it as the type the alias names.
    let c1 = Cell { n: 4294967297 };
    let c2 = Cell { n: 9 };
    let ra = c1.at();
    let rb = c2.at();
    let rt = rboth(ra, rb);
    let rif = if wc { rb } else { ra };
    let lw: Wn = 3;
    let mut la: Wn = 7;
    la = 3;
    print("\nOne alias, one type:");
    print_int(rnot(rt));
    print_int(rnot(rif));
    print_int(lnot(lw));
    print_int(lnot(la));

    // A generic struct's type argument is the alias its value is carried by.
    let tr = Tagged { tag: 1, p: ra };
    let tp = Paired { tag: 2, p: pmake(5) };
    let tn = Narrow { tag: 3, p: seat.wn() };
    let tr1 = tr.p;
    let tp1 = tp.p;
    let tn1 = tn.p;
    print("\nGeneric struct, alias argument:");
    print_int(rnot(tr1));
    print_int(pfirst(tp1));
    print_int(wnot(tn1));

    // A literal is of its own instantiation: the unread `Own<i64, wz>` does not
    // take the `u32` that is not typed by the alias's name.
    let unread = Own { tag: 1, p: seat.wz() };
    let ow: u32 = 7;
    let owide = 4294967297;
    let oc = false;
    let own = if oc { Own { tag: 2, p: ow } } else { Own { tag: 3, p: owide } };
    let og = Own { tag: 4, p: ow };
    print("\nGeneric struct literal, its own instantiation:");
    print_int(own.p);
    print_int(~og.p);

    // The unread expansion's `Own<i64, wz>` does not take the `u32` that is
    // not typed by the alias's name, though all four expansions share a span.
    let mw = seat.wz();
    let munread = own_of!(mw);
    let mv: u32 = 7;
    let mx = 4294967297;
    let moc = false;
    let mown = if moc { own_of!(mv) } else { own_of!(mx) };
    let mog = own_of!(mv);
    print("\nGeneric struct literal, its own node:");
    print_int(mown.p);
    print_int(~mog.p);
}
