// A GENERIC STRUCT LITERAL IN A GENERIC BODY IS OF ITS OWN RECORD (#87).
//
// The type checker never walked a generic function's body, so a struct literal
// there had no record of its own, and code generation matched it against every
// instantiation any other literal had recorded. `unused` below records
// `G<i64, z>` (its value is typed by the name of `type z = u32`), and the
// body's `G { tag: t, p: v }` with `v: i64` was built as that `G_i64_z`: its
// `unsigned int p` held the i64 7 and `~gg.p` printed 4294967288 where `~7` of
// an i64 is -8. Without such a literal, the body's instantiation was recorded
// by nobody and gcc met `incomplete type 'struct G'`. The body is walked now,
// once, in its own type parameters, and each instantiation of it builds the
// literal its record names — where the record holds its values exactly. One
// it does not hold exactly (a `u32` recorded as `i64`) is refused by name:
// tests/reject/generic_literal_not_held_exactly.pd.
type z = u32;

struct S {
    n: i64,
}

impl S {
    fn get(&self) -> z {
        return 7;
    }
}

struct G<X, Y> {
    tag: X,
    p: Y,
}

struct Box<T> {
    v: T,
}

fn build<T>(t: T) -> i64 {
    let v: i64 = 7;
    let gg = G { tag: t, p: v };
    return ~gg.p;
}

// Two body literals an `if` joins: one instantiation, one C struct.
fn meet<T>(t: T) -> i64 {
    let v: i64 = 7;
    let w: i64 = 4294967297;
    let c = false;
    let r = if c { G { tag: t, p: v } } else { G { tag: t, p: w } };
    return r.p;
}

// A value typed by the alias's name is of `G<T, z>`, whose `p` is a `u32`.
fn named<T>(t: T) -> i64 {
    let s = S { n: 0 };
    let v = s.get();
    let gg = G { tag: t, p: v };
    return ~gg.p;
}

// `Box<T>` at each instantiation of `boxed`, and at nothing else.
fn boxed<T>(x: T) -> T {
    let b = Box { v: x };
    return b.v;
}

fn main() {
    let s = S { n: 0 };
    let unused = G { tag: 1, p: s.get() };
    print_int(build(1));
    print_int(meet(1));
    print_int(named(1));
    print_int(boxed(4));
    print(boxed("w"));
}
