// A GENERIC USE IS OF THE WIDTH ITS VALUE HAS (#86, #87, review rounds 3-4).
//
// Code generation emits a call or a struct literal at the instantiation the
// type checker recorded for it where every value is EXACTLY its parameter's or
// field's C type, and the record keeps no integer width (#82). What decides a
// value's exact type here, and was wrong before:
//
// - A parameter is declared at its own C type (`w: u32` is an `unsigned int`)
//   while the generator tracks it as a `long long`, and the declared type was
//   kept in a flat map: an inner block's or a `for`'s `w` over an outer `i64`
//   `w` left a `u32` entry behind, so `inv(w)` of the outer 4294967297 was
//   `inv__z` (4294967294 where `~` of the i64 is -4294967298), and an inner
//   `let w = 9` dropped the parameter's entry for good (-8 where the C
//   `unsigned int` 7 inverts to 4294967288). It is scoped like every binding.
// - A binding is exactly the C type it is declared at, where its value is of
//   that type, and every assignment converts to it: `let y = x` of a `u32`
//   local is an `unsigned int` (main printed -8 for its `~`), and `let mut w =
//   7; w = 4294967297;` stays a `long long`. A value C computes at a width the
//   program never wrote — `v + 0` over a `u32` is `v + 0LL`, a `long long`; a
//   `u32` parameter given to a `let`, which C declares `long long` — has none,
//   and is refused by name (PD0082) rather than computed at a width it never
//   had; an unused such binding in a block does not affect the block's value.
// - A value `if`, `match`, `loop` or block is of the one C type its values
//   have, where each is also the type of the temporary that carries it out;
//   these were refused although their record `G<i64>` holds them exactly.
type z = u32;

struct S {
    n: i64,
}

impl S {
    fn get(&self) -> z {
        return 8;
    }
}

struct G<T> {
    v: T,
}

fn inv<T>(x: T) -> T {
    return ~x;
}

fn inner_block<T>(t: T) -> i64 {
    let w = 4294967297;
    if true {
        let v: u32 = 7;
        let w = v + 0;
    }
    return inv(w);
}

fn for_over_param<T>(t: T, w: u32) -> i64 {
    let xs = [4294967297];
    for w in xs {
        return inv(w);
    }
    return 0;
}

fn param_after_shadow<T>(t: T, w: u32) -> i64 {
    if true {
        let w = 9;
    }
    return inv(w);
}

fn via_let<T>(t: T) -> i64 {
    let x: u32 = 7;
    let y = x;
    return inv(y);
}

fn reassigned<T>(t: T) -> i64 {
    let mut w = 7;
    w = 4294967297;
    return inv(w);
}

fn main() {
    let s = S { n: 0 };
    let zval = s.get();
    print_int(inv(zval));
    let a = inv(8);

    print_int(inner_block(1));
    print_int(for_over_param(1, 7));
    print_int(param_after_shadow(1, 7));

    print_int(via_let(1));
    print_int(reassigned(1));

    let g1 = G { v: if true { 1 } else { 2 } };
    let g2 = G { v: { let x = 1; x + 1 } };
    let n = 3;
    let g3 = G { v: match n { 0 => 10, _ => 20 } };
    let g4 = G { v: loop { break 5; } };
    let u: u32 = 7;
    let g5 = G { v: { let unused = u + 0; 6 } };
    print_int(g1.v);
    print_int(g2.v);
    print_int(g3.v);
    print_int(g4.v);
    print_int(g5.v);
}
