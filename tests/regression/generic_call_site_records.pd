// A GENERIC CALL IS THE INSTANTIATION THE TYPE CHECKER RECORDED FOR IT (#86).
//
// Code generation chose among every instantiation of a generic function by the
// C type of the call's FIRST argument, with substring tests, accepted a type
// argument in ANY position, and fell back to the FIRST instantiation when
// nothing matched. So `half(zval)` below — `zval` is a `u64` typed by the name
// of `z`, recorded `half<z>` — fell through to `half__bool` and was halved as
// an `int`; `snd(1, 2)` beside `snd(1, "hello")` called `snd__i64_String`
// (gcc); and a call inside a generic body could name an instantiation nothing
// had recorded (gcc: undeclared function). Each call is now emitted as its
// record, which holds its arguments exactly. A record that does NOT hold an
// argument exactly (`half(v)` with `v: u32`, recorded `half<i64>`) is refused
// by name: tests/reject/generic_call_not_held_exactly.pd.
type z = u64;

struct S {
    n: i64,
}

impl S {
    fn get(&self) -> z {
        return 9223372036854775807;
    }
}

fn half<T>(x: T) -> T {
    return x / 2;
}

fn snd<A, B>(a: A, b: B) -> B {
    return b;
}

fn pick<T>(n: i64, x: T) -> T {
    return x;
}

fn id<T>(x: T) -> T {
    return x;
}

// Its body's `id(x)` is `id<T>`, and `id<String>` is instantiated by nothing else.
fn wrap<T>(x: T) -> T {
    return id(x);
}

fn main() {
    // The first-entry default: a `u64` beside a `bool` instantiation.
    let b = half(true);
    let s = S { n: 0 };
    let zval = s.get();
    print_int(half(zval));

    // Two instantiations sharing a first type argument.
    let t = snd(1, "hello");
    print(t);
    print_int(snd(1, 2));

    // The type parameter is in the second parameter only.
    print(pick(1, "a"));
    print_int(pick(2, 7));
    let c = pick(3, true);

    // A call inside a generic body.
    print_int(wrap(5));
    print(wrap("s"));
}
