// Test 05: a reference's referent is read in its own scope and derived exactly
// (#88, #90, review round 1).
//
// Every line below RAN on main and prints what main printed. They pin the
// two ways round 1 got them wrong:
//
//   * A NAME IS READ IN THE SCOPE IT IS BOUND IN. `{ let x: i64 = ..; x }`
//     under an outer `x: u32` was read through the OUTER `x` once the block's
//     scope had closed, and `let r: &i64 = &v` was refused — a program main
//     ran. The same through an `if` branch, a `match` arm and a call.
//   * A REFERENT IS DERIVED EXACTLY, as code generation declares the binding:
//     an array repeat's element, a generic's `-> i64` result and a generic
//     struct's field are each the type the C declares, so the `&i64` reading
//     each one runs, and its `&u32` twin is refused by name (the reject
//     fixtures beside this one).
//
// And the two ways round 2 got them wrong:
//
//   * A VALUE `loop` IS READ AS CODE GENERATION DECLARES IT: from its first
//     `break` value read in the scopes outside the loop. A `let n: u32` the
//     body made anywhere — in a closed `if false`, or even in scope at the
//     `break` — was taken to shadow the outer `n: i64`, and `&i64` was
//     refused; main declares `long long` and ran each.
//   * A REFUSAL IS CLASSIFIED BY ITS TYPES, NOT ITS WORDS. In a generic body
//     the unrelated `Type mismatch: expected N, found Int` was kept as a
//     refusal of the reference rules because an unused alias was named
//     `Type`, and `wide(x)` was refused.
//
// And the way round 3 got them wrong:
//
//   * A REFUSAL IS JUDGED BY ITS OWN PAIR. In a generic body a `true` given
//     for an `i64` — beside a correct `&m` for a parameter or a field declared
//     `Type` — was judged by the reference beside it, and `siblings(x)` was
//     refused. Main runs it and prints what this prints.
//
// And the way round 4 got them wrong:
//
//   * A RECOVERED TYPE IS THE CHECKER'S, OR UNKNOWN. `1 + 2.5` in a generic
//     body (mixed operands, which the checker gives no type) was typed by its
//     left operand, an `Int`, and `&v` refused against the `&f64` code
//     generation declares; `mixed(x)` is main's `7`.
struct G<T> {
    n: T,
}

fn read(x: &i64) -> i64 {
    x
}

fn big<T>(t: T) -> i64 {
    4294967297
}

type Type = &i64;
type N = u32;

fn wide<T>(t: T) -> N {
    7
}

struct Holder {
    n: i64,
    p: Type,
}

struct Adder {
    n: i64,
}

impl Adder {
    fn add(&self, k: i64, p: Type) -> i64 {
        *p + 2
    }
}

fn mixed<T>(t: T) -> i64 {
    let v = 1 + 2.5;
    let r: &f64 = &v;
    ((*r) * 2.0) as i64
}

fn siblings<T>(t: T) -> i64 {
    let m = 5;
    let a = Adder { n: 1 };
    let h = Holder { n: true, p: &m };
    a.add(true, &m) + *h.p
}

fn main() {
    let x: u32 = 2;

    let v = { let x: i64 = 4294967297; x };
    let r: &i64 = &v;
    print_int(*r);
    print_int(read(&v));

    let c = true;
    let w = if c { let x: i64 = 4294967298; x } else { 7 };
    let rw: &i64 = &w;
    print_int(*rw);

    let m = match 4294967299 { x => x };
    let rm: &i64 = &m;
    print_int(*rm);

    let a = [4294967300; 2];
    let ra: &i64 = &a[1];
    print_int(*ra);

    let b = big(x);
    let rb: &i64 = &b;
    print_int(*rb);

    let g = G { n: 5 };
    let rg: &i64 = &g.n;
    print_int(*rg);

    let n: i64 = 4294967301;
    let l = loop { if false { let n: u32 = 1; } break n; };
    let rl: &i64 = &l;
    print_int(*rl);

    let k = loop { let n: u32 = 9; break n; };
    let rk: &i64 = &k;
    print_int(*rk);

    print_int(wide(x) as i64);

    print_int(siblings(x));

    print_int(mixed(x));

    print_int(x as i64);
}
