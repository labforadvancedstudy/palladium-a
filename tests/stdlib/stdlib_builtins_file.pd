// Coverage for the file and path builtins in src/builtins.rs.
//
// Return conventions are taken from the C runtime, not from documentation:
//   runtime/palladium_runtime.c:325 pd_path_exists       -> 1 / 0
//   runtime/palladium_runtime.c:358 pd_create_dir        -> 0 ok, -1 fail
//   runtime/palladium_runtime.c:374 pd_create_dir_all    -> 0 ok
//   runtime/palladium_runtime.c:390 pd_remove_file       -> 0 ok, -1 fail
//   runtime/palladium_runtime.c:406 pd_remove_dir        -> 0 ok, -1 fail
//   runtime/palladium_runtime.c:422 pd_remove_dir_all    -> 0 ok
//   runtime/palladium_runtime.c:520 pd_write_string_to_file -> 0 ok, -1 fail
//   runtime/pd_prelude.h:141 __pd_file_open  -> handle >= 1, -1 on failure
//   runtime/pd_prelude.h:177 __pd_file_read_line -> newline stripped, "" at EOF
//
// NOTE: read_file_to_string returns NULL on failure (pd_prelude.h:285), unlike
// arg_at which returns "". Passing that NULL to any string builtin would
// segfault, so only the success path is exercised here; the failure path is
// recorded as a hazard in stdlib/STATUS.md rather than tested.
//
// The scratch tree lives under build_output/ so that it shares the lifetime of
// every other build artefact and `make clean` reclaims it.


// COVERAGE MARKERS. `covers_*` prints `@builtin <name> -> <observed result>`,
// where the result is COMPUTED BY CALLING THE BUILTIN, not written as a literal.
// Where the call mutates state, the result is BOUND ONCE, then marked, then
// asserted — so the marker and the assertion describe the same single call and
// the filesystem is not touched twice.
fn covers_i64(name: String, value: i64) {
    print(string_concat(string_concat("@builtin ", name), string_concat(" -> ", int_to_string(value))));
}

fn covers_str(name: String, value: String) {
    print(string_concat(string_concat("@builtin ", name), string_concat(" -> ", value)));
}

fn covers_bool(name: String, value: bool) {
    if value {
        print(string_concat(string_concat("@builtin ", name), " -> true"));
    } else {
        print(string_concat(string_concat("@builtin ", name), " -> false"));
    }
}

fn expect_i64(label: String, actual: i64, expected: i64) {
    print(label);
    print_int(actual);
    if actual != expected {
        panic("file builtin: value mismatch");
    }
}

fn expect_str(label: String, actual: String, expected: String) {
    print(label);
    print(actual);
    if string_eq(actual, expected) {
        return;
    }
    panic("file builtin: string mismatch");
}

fn expect_true(label: String, actual: bool) {
    print(label);
    if actual {
        print("true");
        return;
    }
    print("false");
    panic("file builtin: expected true");
}

fn expect_false(label: String, actual: bool) {
    print(label);
    if actual {
        print("true");
        panic("file builtin: expected false");
    }
    print("false");
}

fn main() {
    let root = "build_output/stdlib_gate_tmp";
    let nested = "build_output/stdlib_gate_tmp/a/b";
    let data_path = "build_output/stdlib_gate_tmp/data.txt";
    let handle_path = "build_output/stdlib_gate_tmp/handle.txt";
    let absent = "build_output/stdlib_gate_tmp/definitely-absent.txt";
    let flush_path = "build_output/stdlib_gate_tmp/flush.txt";

    // Leftovers from an earlier run would make the transcript depend on
    // history, so clear the tree first. The result is deliberately not
    // asserted: it differs between a first and a repeat run.
    let _cleanup = remove_dir_all(root);

    // ---- create_dir / create_dir_all ----
    // Provenance: palladium_runtime.c:358,374 — 0 on success, -1 on failure.
    let rc_mkdir = create_dir(root);
    covers_i64("create_dir", rc_mkdir);
    expect_i64("create_dir_root", rc_mkdir, 0);
    let rc_mkdirp = create_dir_all(nested);
    covers_i64("create_dir_all", rc_mkdirp);
    expect_i64("create_dir_all_nested", rc_mkdirp, 0);

    // ---- path_exists / path_is_dir / path_is_file ----
    // Provenance: palladium_runtime.c:325,332,343 — stat-based, 1/0.
    covers_bool("path_exists", path_exists(root));
    expect_true("path_exists_root", path_exists(root));
    covers_bool("path_is_dir", path_is_dir(root));
    expect_true("path_is_dir_root", path_is_dir(root));
    covers_bool("path_is_file", path_is_file(root));
    expect_false("path_is_file_root", path_is_file(root));
    expect_true("path_is_dir_nested", path_is_dir(nested));
    expect_false("path_exists_absent", path_exists(absent));
    expect_false("path_is_file_absent", path_is_file(absent));
    expect_false("path_is_dir_absent", path_is_dir(absent));

    // ---- write_string_to_file / read_file_to_string ----
    // Provenance: palladium_runtime.c:520 — fopen "wb" (truncates), 0 on success.
    // read_file_to_string: only the SUCCESS path is exercised; on failure it
    // returns NULL (pd_prelude.h:285), which would segfault any string builtin.
    // Recorded PARTIAL in BUILTINS.tsv for exactly that reason.
    let rc_write = write_string_to_file(data_path, "hello\nworld\n");
    covers_i64("write_string_to_file", rc_write);
    expect_i64("write_string_to_file", rc_write, 0);
    expect_true("path_is_file_data", path_is_file(data_path));
    expect_false("path_is_dir_data", path_is_dir(data_path));
    expect_str("read_file_to_string", read_file_to_string(data_path), "hello\nworld\n");
    covers_i64("read_file_to_string", string_len(read_file_to_string(data_path)));
    expect_i64("read_file_len", string_len(read_file_to_string(data_path)), 12);

    // Overwrite semantics: "wb" truncates.
    expect_i64("rewrite", write_string_to_file(data_path, "xy"), 0);
    expect_str("read_after_rewrite", read_file_to_string(data_path), "xy");

    // ---- file_open / file_write / file_close / file_exists ----
    // Provenance: pd_prelude.h:141 — handles start at 1, -1 on failure;
    // :177 fputs>=0, :183 fclose==0, :190 fopen "r" probe.
    expect_false("file_exists_before", file_exists(handle_path));
    let h = file_open(handle_path);
    covers_bool("file_open", h >= 1);
    expect_true("file_open_handle", h >= 1);
    let ok_write = file_write(h, "line1\nline2\n");
    covers_bool("file_write", ok_write);
    expect_true("file_write", ok_write);
    let ok_close = file_close(h);
    covers_bool("file_close", ok_close);
    expect_true("file_close", ok_close);
    covers_bool("file_exists", file_exists(handle_path));
    expect_true("file_exists_after", file_exists(handle_path));
    expect_false("file_exists_absent", file_exists(absent));

    // ---- file_read_all ----
    // Provenance: pd_prelude.h:150 — seeks to end for the size, reads whole file.
    let h2 = file_open(handle_path);
    expect_true("file_open_reread", h2 >= 1);
    covers_i64("file_read_all", string_len(file_read_all(h2)));
    let h2b = file_open(handle_path);
    expect_str("file_read_all", file_read_all(h2b), "line1\nline2\n");
    expect_true("file_close_h2b", file_close(h2b));
    expect_true("file_close_reread", file_close(h2));

    // ---- file_read_line (newline stripped, "" at EOF) ----
    // Provenance: pd_prelude.h:163 — fgets, trailing newline stripped, "" at EOF.
    let h3 = file_open(handle_path);
    let line1 = file_read_line(h3);
    covers_str("file_read_line", line1);
    expect_str("file_read_line_1", line1, "line1");
    expect_str("file_read_line_2", file_read_line(h3), "line2");
    expect_str("file_read_line_eof", file_read_line(h3), "");
    expect_true("file_close_lines", file_close(h3));

    // ---- file_seek / file_flush ----
    // These two were REGISTERED BUT NOT CALLABLE until 2026-08-23: their C
    // wrappers took the enhanced API's opaque `FileHandle` while a Palladium
    // handle is an i64, so `let r = file_seek(1, 0, 0);` was refused at
    // typecheck. They are lowered onto `__pd_file_handles` now, and this is the
    // first coverage either has ever had.
    //
    // Provenance, read off the emitted wrappers rather than documentation:
    //   __pd_file_seek(handle, whence, offset) -> new absolute position, or -1.
    //     whence 0 = SEEK_SET, 1 = SEEK_CUR, 2 = SEEK_END; anything else is -1,
    //     which is a REFUSAL and not an out-of-range seek.
    //   __pd_file_flush(handle) -> 1 on success, 0 on failure — the convention
    //     __pd_file_write and __pd_file_close already use.
    // The file holds "line1\nline2\n", which is 12 bytes.
    let h4 = file_open(handle_path);
    expect_true("file_open_seek", h4 >= 1);
    let pos_set = file_seek(h4, 0, 6);
    covers_i64("file_seek", pos_set);
    expect_i64("file_seek_set", pos_set, 6);
    expect_i64("file_seek_cur", file_seek(h4, 1, 2), 8);
    expect_i64("file_seek_end", file_seek(h4, 2, 0), 12);
    // ...and the position it reports is the position it reads from.
    expect_i64("file_seek_rewind", file_seek(h4, 0, 6), 6);
    expect_str("file_seek_reads_from_there", file_read_line(h4), "line2");
    // An unrecognised whence is refused, not treated as SEEK_SET.
    expect_i64("file_seek_bad_whence", file_seek(h4, 9, 0), -1);
    expect_i64("file_seek_bad_handle", file_seek(9999, 0, 0), -1);
    expect_true("file_close_seek", file_close(h4));

    let h5 = file_open(flush_path);
    expect_true("file_open_flush", h5 >= 1);
    expect_true("file_write_flush", file_write(h5, "flushed"));
    let flushed = file_flush(h5);
    covers_i64("file_flush", flushed);
    expect_i64("file_flush_ok", flushed, 1);
    // The point of flushing: the bytes are readable before the handle is closed.
    let h5r = file_open(flush_path);
    expect_str("file_flush_is_observable", file_read_all(h5r), "flushed");
    expect_true("file_close_flush_reader", file_close(h5r));
    expect_true("file_close_flush", file_close(h5));
    expect_i64("file_flush_bad_handle", file_flush(9999), 0);

    // Invalid handles are rejected rather than dereferenced.
    expect_false("file_write_bad_handle", file_write(0, "nope"));
    expect_false("file_close_bad_handle", file_close(9999));
    expect_str("file_read_all_bad_handle", file_read_all(0), "");
    expect_str("file_read_line_bad_handle", file_read_line(-1), "");

    // ---- remove_file / remove_dir / remove_dir_all ----
    // Provenance: palladium_runtime.c:390,406,422 — 0 on success, -1 on failure.
    // rmdir refuses a non-empty directory; remove_dir_all recurses.
    let rc_rm = remove_file(data_path);
    covers_i64("remove_file", rc_rm);
    expect_i64("remove_file_data", rc_rm, 0);
    expect_false("path_exists_after_remove", path_exists(data_path));
    expect_i64("remove_file_absent", remove_file(absent), -1);
    let rc_rmdir = remove_dir(nested);
    covers_i64("remove_dir", rc_rmdir);
    expect_i64("remove_dir_nested", rc_rmdir, 0);
    expect_false("nested_gone", path_exists(nested));
    // A non-empty directory cannot be rmdir'd; remove_dir_all can.
    expect_i64("remove_dir_non_empty", remove_dir(root), -1);
    let rc_rmtree = remove_dir_all(root);
    covers_i64("remove_dir_all", rc_rmtree);
    expect_i64("remove_dir_all_root", rc_rmtree, 0);
    expect_false("root_gone", path_exists(root));

    print("builtins_file_ok");
}
