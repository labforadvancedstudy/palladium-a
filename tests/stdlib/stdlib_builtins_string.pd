// Coverage for the string builtins in src/builtins.rs.
//
// COVERAGE MARKERS: each section prints `@builtin <name>` immediately before
// exercising <name>. That line lands in the golden transcript, so the gate can
// require runtime evidence that the section actually ran instead of trusting a
// grep over source that a dead branch would satisfy. See scripts/stdlib-gate.sh
// Phase 3.
//
// PROVENANCE: every expected value is derived from the C runtime or from the C
// standard, and the derivation is stated beside it. A golden transcript records
// what the compiler currently prints; only these comments record why that is
// the CORRECT answer. Editing a golden without editing the reasoning here is a
// contract change with no argument behind it.
//
// Transcript verification of this file belongs to `make conformance`, which
// diffs stdout against the sibling .expected. `make stdlib-gate` checks the
// generated C for structural defects instead. One mechanism each.


// COVERAGE MARKERS. `covers_*` prints `@builtin <name> -> <observed result>`,
// where the result is COMPUTED BY CALLING THE BUILTIN, not written as a literal.
// The line therefore cannot be produced without the call running and returning
// that value: delete the call and the golden loses the line; change the result
// and the golden changes. scripts/stdlib-gate.sh Phase 3 requires the marker to
// appear in THIS driver's own golden, so a marker in one file can no longer
// vouch for a call in another.
fn covers_i64(name: String, value: i64) {
    print(string_concat(string_concat("@builtin ", name), string_concat(" -> ", int_to_string(value))));
}

fn covers_str(name: String, value: String) {
    print(string_concat(string_concat("@builtin ", name), string_concat(" -> ", value)));
}

fn covers_bool(name: String, value: bool) {
    if value {
        print(string_concat(string_concat("@builtin ", name), " -> true"));
    } else {
        print(string_concat(string_concat("@builtin ", name), " -> false"));
    }
}

fn expect_i64(label: String, actual: i64, expected: i64) {
    print(label);
    print_int(actual);
    if actual != expected {
        panic("string builtin: value mismatch");
    }
}

fn expect_str(label: String, actual: String, expected: String) {
    print(label);
    print(actual);
    if string_eq(actual, expected) {
        return;
    }
    panic("string builtin: string mismatch");
}

fn expect_true(label: String, actual: bool) {
    print(label);
    if actual {
        print("true");
        return;
    }
    print("false");
    panic("string builtin: expected true");
}

fn expect_false(label: String, actual: bool) {
    print(label);
    if actual {
        print("true");
        panic("string builtin: expected false");
    }
    print("false");
}

fn main() {
    // ---- print / print_int -------------------------------------------------
    // Provenance: runtime/pd_prelude.h:60,64 — both printf with a trailing
    // newline. Every other line of this transcript is evidence that they work.
        // print/print_int return nothing, so there is no result to observe. Their
    // effect IS every line of this transcript; recorded COVERED_BY_EFFECT.
    print("@builtin print");
    print("print_literal");
    print("@builtin print_int");
    // i64 min+1: pins %lld rather than %d truncation.
    print_int(-9223372036854775807);

    // ---- string_len --------------------------------------------------------
    // Provenance: runtime/pd_prelude.h:73 -> strlen = bytes before the NUL.
    covers_i64("string_len", string_len("abcd"));
    expect_i64("string_len_empty", string_len(""), 0);
    expect_i64("string_len_abcd", string_len("abcd"), 4);
    // 3 bytes: the lexer decodes "\n" to one byte, it is not passed through raw.
    expect_i64("string_len_escape", string_len("a\nb"), 3);

    // ---- string_concat -----------------------------------------------------
    // Provenance: runtime/pd_prelude.h:77 — allocates len1+len2+1, copies both.
    covers_str("string_concat", string_concat("foo", "bar"));
    expect_str("string_concat", string_concat("foo", "bar"), "foobar");
    expect_str("string_concat_empty_lhs", string_concat("", "bar"), "bar");
    expect_str("string_concat_empty_rhs", string_concat("foo", ""), "foo");

    // ---- string_eq ---------------------------------------------------------
    // Provenance: runtime/pd_prelude.h:80 -> strcmp == 0. Full-length equality,
    // so a strict prefix must NOT compare equal.
    covers_bool("string_eq", string_eq("abc", "abc"));
    expect_true("string_eq_same", string_eq("abc", "abc"));
    expect_false("string_eq_diff", string_eq("abc", "abd"));
    expect_false("string_eq_prefix", string_eq("abc", "ab"));
    expect_true("string_eq_empty", string_eq("", ""));

    // ---- string_char_at ----------------------------------------------------
    // N14-04: THIS BUILT-IN RETURNS A `char`. It returned an `i64` until N4-04
    // gave the language a char type, and the two rows had to move together —
    // a char literal that no built-in accepted would have been a type with
    // nowhere to go.
    //
    // THE `-1` SENTINEL IS GONE, and its two rows here went with it. It was an
    // integer meaning "no character", readable only by a caller who knew to
    // look, and -1 is not a `char`. Nothing in this repo ever read it: measured
    // across the corpus, `bootstrap/pdc.pd` guards its own bounds and no
    // program compares a result against -1. An out-of-range index now traps at
    // the call, the way N6-11 traps a match with no arm to take, so there is no
    // in-language assertion to write for it — the contract this fixture pins is
    // the IN-BOUNDS one, and the trap is pinned by
    // `test_string_char_at_traps_instead_of_returning_a_non_char` in src/codegen.
    covers_i64("string_char_at", string_char_at("abc", 0) as i64);
    expect_i64("string_char_at_0", string_char_at("abc", 0) as i64, 'a' as i64);
    expect_i64("string_char_at_2", string_char_at("abc", 2) as i64, 'c' as i64);
    // The last valid index, which is where an off-by-one would land.
    expect_i64("string_char_at_last", string_char_at("abc", 2) as i64, 99);

    // ---- string_substring --------------------------------------------------
    // Provenance: runtime/pd_prelude.h:95 — half-open [start, end); start clamps
    // up to 0, end clamps down to len, and start >= end yields "".
    covers_str("string_substring", string_substring("hello world", 1, 4));
    expect_str("string_substring_mid", string_substring("hello world", 0, 5), "hello");
    expect_str("string_substring_tail", string_substring("hello world", 6, 11), "world");
    expect_str("string_substring_clamp_end", string_substring("abc", 1, 99), "bc");
    expect_str("string_substring_empty", string_substring("abc", 2, 2), "");
    expect_str("string_substring_inverted", string_substring("abc", 2, 1), "");

    // ---- string_from_char --------------------------------------------------
    // Provenance: runtime/pd_prelude.h:107 — one byte plus NUL.
    // N14-04: the parameter is a `char`, so the call site says which character
    // it means instead of spelling the code point and explaining it in a
    // comment. `'A'` is 65 and `'z'` is 122; the fixture no longer has to say so.
    covers_str("string_from_char", string_from_char('A'));
    expect_str("string_from_char_A", string_from_char('A'), "A");
    expect_str("string_from_char_z", string_from_char('z'), "z");

    // ---- string_to_int -----------------------------------------------------
    // Provenance: runtime/pd_prelude.h:126 -> atoll. C99 7.20.1.2 specifies 0
    // when no conversion can be performed, which is why "abc" is 0 rather than
    // an error: this builtin has no way to report failure.
    covers_i64("string_to_int", string_to_int("42"));
    expect_i64("string_to_int_42", string_to_int("42"), 42);
    expect_i64("string_to_int_neg", string_to_int("-7"), -7);
    expect_i64("string_to_int_garbage", string_to_int("abc"), 0);

    // ---- int_to_string -----------------------------------------------------
    // Provenance: runtime/pd_prelude.h:130 -> snprintf "%lld" into 32 bytes, so
    // every i64 (20 chars incl. sign at most) round-trips without truncation.
    covers_str("int_to_string", int_to_string(-123));
    expect_str("int_to_string_0", int_to_string(0), "0");
    expect_str("int_to_string_neg", int_to_string(-123), "-123");
    // 2^53+1: exact in i64 and NOT representable in f64, so this pins integer
    // formatting rather than a float path.
    expect_str("int_to_string_big", int_to_string(9007199254740993), "9007199254740993");

    // Round trip: %lld out, atoll back in.
    expect_i64("round_trip", string_to_int(int_to_string(31337)), 31337);

    print("builtins_string_ok");
}
