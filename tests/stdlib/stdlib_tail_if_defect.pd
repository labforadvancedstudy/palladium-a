// KNOWN-DEFECT FIXTURE — D3 is only HALF fixed, and this pins the other half.
//
// `src/parser/mod.rs:536` lowers a tail *expression* to `Stmt::Return`, but a
// tail `if` is not an `Stmt::Expr`, so it is never lowered. Every function whose
// body ends in an `if`/`else` — the natural shape for a recursive base case —
// still miscompiles exactly the way the original D3 did.
//
// Measured 2026-08-22 with the CURRENT compiler (D3 "fixed"):
//
//     fn fib(n: i64) -> i64 { if n <= 1 { n } else { fib(n-1) + fib(n-2) } }
//
//   emits
//     long long fib(long long n) {
//         if ((n <= 1)) {
//         n;                                  <- bare expression, no return
//         } else {
//         (fib((n - 1)) + fib((n - 2)));      <- bare expression, no return
//         }
//     }
//   and `fib(10)` printed 8261746944 instead of 55, exit 0, no diagnostic.
//
// WHY main() DOES NOT CALL THESE FUNCTIONS
// Calling them returns garbage. Recording that garbage in a golden transcript
// would bless a miscompile as expected behaviour — the precise failure this
// directory exists to prevent. So this file is a CODEGEN fixture: what is
// asserted about it is the shape of the C it emits, not what it prints. Its
// transcript is a constant, so it is also a well-behaved conformance fixture
// and stays green there.
//
// PINNED EXPECTATION: tests/stdlib/DRIVERS.tsv records this file as
//   known_violation:fib,classify
// so `make stdlib-gate` requires the structural invariant to be violated in
// exactly those two functions. When the parser learns to lower a tail `if`, the
// violation disappears, the gate reports XPASS, and this file is promoted to an
// ordinary driver whose main() calls fib(10) and asserts 55.
//
// DO NOT "fix" this file. The defect is in the compiler, not here.

// Tail `if` with no explicit return anywhere: zero returns are emitted.
fn fib(n: i64) -> i64 {
    if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

// Early explicit return, THEN a tail `if`. This shape is why the invariant is
// phrased as "returns on every path" rather than "contains a return": the
// weaker rule sees `return 0;` and passes the function, while classify(5)
// returns 0 instead of 10.
fn classify(n: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    if n <= 1 { n } else { n * 2 }
}

fn main() {
    print("tail_if_defect_fixture");
    print("fib and classify are defined above and deliberately not called");
    print("see tests/stdlib/DRIVERS.tsv for the pinned expectation");
}
